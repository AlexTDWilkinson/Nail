# Generated by Cargo
# will have compiled files and executables
debug/
target/

# The root Cargo.lock is TRACKED, deliberately. Nail ships executables, and a
# release is supposed to mean one exact set of bytes: without the lock,
# Cargo.toml's caret ranges would resolve differently on different days and two
# builds of "0.1.0" would not be the same compiler. The version line in a
# source file names a release, so a release has to name exactly one thing.
#
# playground_wasm's lock is NOT tracked: its Cargo.toml pins the nail crate by
# path, so the lock would only churn with the root one.
playground_wasm/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

/target
/build
*/*.log
*.log
nail.log
.nail

.claude/
test_results.txt

# Build artifacts
examples/**/*.rs
tests/**/*.rs
*_transpilation/
bundle/downloads/
bundle/*.tar.xz

# Deploy credentials - never commit
.env

# Profiler dump written by every instrumented Nail program
.nail_profile.json
.nail_profile.json.tmp
wasm_demos

# Build directory nail run/build/test and the IDE create beside a source file.
# The website's generated server project lives in target/nail_website_server,
# covered by target/ above.
.nail-build/

# Records which commit a built bundle came from, beside the tarball
bundle/*.built-from
