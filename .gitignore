# Generated by Cargo
# will have compiled files and executables
debug/
target/

# The root Cargo.lock is TRACKED, deliberately. Nail ships executables, and a
# release is supposed to mean one exact set of bytes: without the lock,
# Cargo.toml's caret ranges would resolve differently on different days and two
# builds of "0.1.0" would not be the same compiler. The version line in a
# source file names a release, so a release has to name exactly one thing.
#
# The locks below belong to generated sub-projects whose Cargo.toml is itself
# regenerated on every build, so pinning them would only produce churn.
nail_website_server/Cargo.lock
playground_wasm/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

/target
/build
/transpilation
*/*.log
*.log
nail.log
.nail

.claude/
test_results.txt

# Build artifacts
nail-website
nail_website_build/
examples/*.rs
tests/**/*.rs
*_transpilation/nail_website_server/
bundle/downloads/
bundle/*.tar.xz

# Deploy credentials - never commit
.env

# Transpiler output - regenerated by scripts/deploy.sh, never committed
nail_website_server/src/main.rs

# Profiler dump written by every instrumented Nail program
.nail_profile.json
.nail_profile.json.tmp
wasm_demos

# Build directory nail run/build/test creates beside a source file
.nail-build/
