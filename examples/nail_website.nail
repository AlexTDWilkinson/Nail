// The Nail website: a real web server, written in Nail, that serves the page
// describing Nail. This file is the entry point and the table of contents.
//
// The program is split across files with Nail's compile-time file inclusion:
// each line below splices that file in at lex time, in this order, as if its
// contents were typed here.
//
//   website/safe/demo_math.nail       arithmetic for the live demos, sealed
//   website/safe/stdlib_listing.nail  sort and row helpers for the library page, sealed
//   website/safe/text_helpers.nail    small string shapers, sealed
//   website/startup_data.nail         site config, file reads, demo values computed at startup
//   website/styles.nail               the page stylesheet
//   website/page_sections.nail        the HTML builders, one function per section
//   website/server_state.nail         page assembly, handler state, keep-warm ping
//   website/routes.nail               the request handler and its routes
//
// Below the inserts is the server wiring itself.

port:i = 8080;

// insert() trusts a file completely: it is for code you wrote yourself.
// insert_safe() is for code you did not write. The compiler seals the file so
// it can compute anything and touch nothing: no network, no disk, no
// environment, no processes, no global state, checked at compile time and
// enforced through every function the sealed code reaches. The three files
// below could be downloaded from the internet and inserted unread, nothing in
// them can act on this machine. If Nail ever grows a package repository, it
// will be a folder of simple files brought in exactly like this.
insert_safe(`website/safe/demo_math.nail`)
insert_safe(`website/safe/stdlib_listing.nail`)
insert_safe(`website/safe/text_helpers.nail`)

// The rest of the program is our own code and stays fully trusted: these
// files read the disk, hold the server state, and answer requests.
insert(`website/startup_data.nail`)
insert(`website/styles.nail`)
insert(`website/page_sections.nail`)
insert(`website/server_state.nail`)
insert(`website/routes.nail`)

// Serve the website
config:HTTP_Config = HTTP_Config {
    static_mounts = [],
    max_body_bytes = 0,
    timeout_seconds = 0,
    state = state,
    cors_origins = [],
    security_headers = false,
    rate_limit_per_minute = 0,
    rate_limit_message = ``
};
http_server(port, config);
print(`Server running on http://localhost:`, port);
