nail latest
// This is not a standalone program: examples/website/main.nail imports it.
// The HTML builders: one function per section of the page, plus the head,
// the navbar, the footer and the menu script.

// Generate HTML sections
f generate_head(site_title:s, site_description:s):s {
    values:h<s,s> = hashmap_new();
    hashmap_set(values, `title`, site_title);
    hashmap_set(values, `description`, site_description);
    hashmap_set(values, `stylesheet`, generate_css());

    // The title and description are escaped by the template. The stylesheet is
    // put in raw, with three braces: escaping it would turn every `>` in a
    // selector into markup and break the page.
    r danger(template_render(html`<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f1117">
    <meta name="description" content="{{description}}">
    <title>{{title}}</title>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>{{{stylesheet}}}</style>
</head>`, values));
}

f generate_navbar(nav_html:s):s {
    navbar_html:s = array_join([
        html`<nav class="navbar">
    <div class="nav-container">
        <a href="/" class="nav-brand" aria-label="Nail home">
            <span style="font-size: 1.5rem;">🔨</span>
            <span>Nail</span>
        </a>
        <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
            <svg class="nav-icon-open" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M3 6h14M3 10h14M3 14h14"></path>
            </svg>
            <svg class="nav-icon-close" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="display: none;">
                <path d="M5 5l10 10M15 5L5 15"></path>
            </svg>
        </button>
        <div class="nav-links" id="nav-links">`,
        nav_html,
        html`</div>
    </div>
</nav>`
    ], ``);
    r navbar_html;
}

f generate_hero(hero_code:s):s {
    hero_html:s = array_join([
        html`<section id="home" class="hero">
    <h1 class="hero-title">Nail</h1>
    <p class="hero-tagline">Rust's speed, Python's ease, zero dependencies</p>
    <p class="hero-description">
        A small language with a huge standard library. No null, no mutation, no package manager,
        no unsafe. Errors you can't ignore. Iteration that runs in parallel when it is safe to.
    </p>
    <p class="hero-description">
        One command turns your file into a Rust program, so it is as fast and as memory safe as
        Rust whether or not you know Rust. Every file pins the compiler that wrote it, so what
        compiled once compiles forever.
    </p>
    <div class="hero-actions">
        <a href="#start" class="btn btn-primary">Get started</a>
        <a href="#examples" class="btn btn-secondary">See examples</a>
    </div>
    <div class="code-example" style="max-width: 680px; margin: 3rem auto 1rem; text-align: left;">
        <span class="code-label">Nail</span><pre>`,
        hero_code,
        html`</pre>
    </div>
    <p style="color: var(--text-secondary);">
        This page is a Nail program: server, highlighting, compiler output, all of it.
        <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/examples/website/main.nail" target="_blank" style="color: var(--primary); text-decoration: underline;">Read its source →</a>
    </p>
</section>`
    ], ``);
    r hero_html;
}

f generate_whole_language(snippet_html:s, rust_line_count:i):s {
    values:h<s,s> = hashmap_new();
    hashmap_set(values, `snippet`, snippet_html);
    hashmap_set(values, `rust_lines`, string_from(rust_line_count));
    r danger(template_render(html`<section id="philosophy" class="philosophy">
    <div class="section-header">
        <h2>The whole language on one screen</h2>
        <p>If it is not on this screen, Nail does not have it</p>
    </div>
    <div class="code-example">
        <span class="code-label">whole_language.nail</span>
        <pre>{{{snippet}}}</pre>
    </div>
    <p class="sandbox-note">
        It compiles. This server checked it with its own compiler at startup, where it became
        {{rust_lines}} lines of Rust.
    </p>
</section>`, values));
}

// One refused file: the code, then the compiler's answer under it.
f refusal_pane(title:s, code_html:s, verdict_html:s):s {
    values:h<s,s> = hashmap_new();
    hashmap_set(values, `title`, title);
    hashmap_set(values, `code`, code_html);
    hashmap_set(values, `verdict`, verdict_html);
    r danger(template_render(html`<div class="refusal-pane">
        <div class="code-example sandbox-code">
            <span class="code-label">{{title}}</span>
            <pre>{{{code}}}</pre>
        </div>
        <div class="code-example sandbox-verdict">
            <span class="code-label">The compiler's answer</span>
            <pre>{{{verdict}}}</pre>
        </div>
    </div>`, values));
}

f generate_refusals(error_html:s, error_verdict:s, field_html:s, field_verdict:s, nothing_html:s, nothing_verdict:s):s {
    panes:s = array_join([
        refusal_pane(`Ignoring a failure`, error_html, error_verdict),
        refusal_pane(`Forgetting a field`, field_html, field_verdict),
        refusal_pane(`Keeping a nothing`, nothing_html, nothing_verdict)
    ], ``);
    r array_join([html`<section id="refusals" class="refusals">
    <div class="section-header">
        <h2>Bugs do not compile</h2>
        <p>Three everyday mistakes, refused by this server's own compiler at startup. The panes
           are editable: fix one and the same compiler, running in your browser, changes its
           verdict</p>
    </div>
    <div class="refusal-grid">`, panes, html`</div>
</section>`], ``);
}

f generate_features():s {
    features_data:a:s = [
        html`<div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>Nothing changes behind your back</h3>
            <p>A name keeps its value. Nothing elsewhere can overwrite it, so there is never a
               hunt for what did.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">👻</div>
            <h3>Nothing is ever empty</h3>
            <p>No null, no undefined, no declared-but-unset. Every name holds a real value from
               the moment it exists.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">🔄</div>
            <h3>Say what you want, not how to loop</h3>
            <p>map changes every item, filter keeps some, reduce folds them into one. No counters,
               so no off-by-one.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Many things at once, safely</h3>
            <p>A c block waits on files and networks together. A p block spreads CPU work over every
               core. You never touch a thread.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">🔀</div>
            <h3>Errors can't be ignored</h3>
            <p>Anything that can fail returns something you must handle: safe() for a fallback,
               danger() to accept the crash.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">🚫</div>
            <h3>No escape hatch, no supply chain</h3>
            <p>No unsafe to switch the rules off, no package manager pulling in dependency trees.
               Your program is what you wrote.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">🛡️</div>
            <h3>Foreign code runs sandboxed</h3>
            <p>import sandboxes downloaded code at compile time: no network, no disk, no way to
               phone home.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">📦</div>
            <h3>Batteries included</h3>
            <p>A thousand functions built in: servers, databases, stats, money, geo. Nothing to
               install.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">🗣️</div>
            <h3>Errors that explain themselves</h3>
            <p>Every message says what broke, where, why, and how to fix it. The wording is
               pinned by tests.</p>
        </div>`,
        html`<div class="feature-card">
            <div class="feature-icon">🧳</div>
            <h3>One file becomes one binary</h3>
            <p>Your program becomes Rust, then one static executable. Deploying is copying it.</p>
        </div>`
    ];
    
    features_html:s = array_join(features_data, ``);
    
    section_html:s = array_join([
        html`<section id="features" class="features">
    <div class="section-header">
        <h2>Key features</h2>
        <p>Every feature here exists to make a whole family of bugs impossible to write</p>
    </div>
    <div class="features-grid">`,
        features_html,
        `
    </div>
</section>`
    ], ``);
    r section_html;
}

f generate_examples(concurrent_example:s, parallel_example:s, error_example:s, concurrent_rust:s, parallel_rust:s, error_rust:s):s {
    examples_html:s = array_join([
        html`<section id="examples" class="examples">
    <div class="section-header">
        <h2>Code examples</h2>
        <p>Nothing here is a mockup. ▶ Run serves output this server really computed, the
           highlighting is Nail's own lexer, and every Rust panel is what the transpiler emitted.</p>
    </div>

    <div style="color: var(--text-secondary); max-width: 56rem; margin: 0 auto 2rem;">
        <p>Two blocks run statements at the same time, against different bottlenecks:</p>
        <ul class="point-list">
            <li><strong>c</strong> is concurrency: one thread starts every wait at once. It wins
                when the slow part is the outside world (disks, networks, timers).</li>
            <li><strong>p</strong> is parallelism: every statement gets its own core. It wins
                when the slow part is your own computation.</li>
        </ul>
        <p>Overlapping waits is nearly free. Multiplying work takes more hardware.</p>
    </div>

    <div style="display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr);">
        <div>
            <h3 style="margin-bottom: 1rem;">Concurrent I/O operations (c.../c)</h3>
            <div class="code-example" style="position: relative;">
                <span class="code-label">Nail</span>
                <button onclick="fetch('/run-example?name=concurrent').then(r=>r.json()).then(d=>{let el=document.getElementById('concurrent-output');el.style.display='block';el.textContent=d.output})" class="run-btn">▶ Run</button>
                <pre>`,
        concurrent_example,
        html`</pre>
            </div>
            <details class="rust-details">
                <summary>🦀 View the generated Rust (tokio::join! under the hood)</summary>
                <div class="code-example"><span class="code-label">Generated Rust</span><pre>`,
        concurrent_rust,
        html`</pre></div>
            </details>
            <pre id="concurrent-output" class="run-output" style="display: none;"></pre>
            <p style="color: var(--text-secondary); margin-top: 1rem;">
                Everything inside c.../c starts at once and the block ends when all of it
                finishes, so three waits cost one. The compiler emits tokio::join!, the same idea
                as Promise.all in JavaScript or goroutines plus a WaitGroup in Go. It cannot make
                computation faster: one thread is still doing the computing. Why not p here? An OS
                thread costs megabytes of stack to sit asleep on a disk read, while a c task waits
                for close to free, so c scales to thousands of simultaneous waits. Past /c the
                values are ordinary and immutable, with no await left to forget.
            </p>
        </div>
        
        <div>
            <h3 style="margin-bottom: 1rem;">Parallel CPU work (p.../p)</h3>
            <div class="code-example" style="position: relative;">
                <span class="code-label">Nail</span>
                <button onclick="fetch('/run-example?name=parallel').then(r=>r.json()).then(d=>{let el=document.getElementById('parallel-output');el.style.display='block';el.textContent=d.output})" class="run-btn">▶ Run</button>
                <pre>`,
        parallel_example,
        html`</pre>
            </div>
            <details class="rust-details">
                <summary>🦀 View the generated Rust (thread spawn + join barrier)</summary>
                <div class="code-example"><span class="code-label">Generated Rust</span><pre>`,
        parallel_rust,
        html`</pre></div>
            </details>
            <pre id="parallel-output" class="run-output" style="display: none;"></pre>
            <p style="color: var(--text-secondary); margin-top: 1rem;">
                Each statement in p.../p gets its own thread on its own core, joined at /p, so
                every value below the block is ready. Three computations happen in the same
                instant, so the block costs its slowest statement instead of the sum. Threads only
                pay off because these jobs burn CPU instead of waiting. No locks, because there is
                nothing mutable to lock. Rule of thumb: c when the bottleneck is waiting, p when
                it is computing.
            </p>
        </div>
        
        <div>
            <h3 style="margin-bottom: 1rem;">Error handling done right</h3>
            <div class="code-example" style="position: relative;">
                <span class="code-label">Nail</span>
                <button onclick="fetch('/run-example?name=error').then(r=>r.json()).then(d=>{let el=document.getElementById('error-output');el.style.display='block';el.textContent=d.output})" class="run-btn">▶ Run</button>
                <pre>`,
        error_example,
        html`</pre>
            </div>
            <details class="rust-details">
                <summary>🦀 View the generated Rust (Result types, no exceptions)</summary>
                <div class="code-example"><span class="code-label">Generated Rust</span><pre>`,
        error_rust,
        html`</pre></div>
            </details>
            <pre id="error-output" class="run-output" style="display: none;"></pre>
            <p style="color: var(--text-secondary); margin-top: 1rem;">
                divide returns i!e, an integer or an error, and Nail will not compile code that
                ignores the error half. Handle it with safe() and a fallback, or accept the crash
                with danger(). Every error path is written down, and the compiler checks it.
            </p>
        </div>
    </div>
</section>`
    ], ``);
    r examples_html;
}

f generate_get_started():s {
    r html`<section id="start" class="philosophy">
    <div class="section-header">
        <h2>Get started</h2>
        <p>One download. No Rust to install, no C compiler, nothing else on the machine.</p>
    </div>
    <div class="philosophy-content">
        <div class="code-example"><span class="code-label">Shell</span><pre>curl -fsSL https://nail.alex-wilkinson.ca/install | sudo sh

# Opens the file in Nail's own IDE
nail hello.nail</pre></div>
        <p>
            That installs to <code>/opt/nail</code> and hands the directory to the user who ran
            it. The sudo is for that one command and nothing after it: installing a version,
            updating, reclaiming disk and removing versions are all yours to do without it.
            <code>sudo rm -rf /opt/nail /usr/local/bin/nail</code> is the uninstaller.
        </p>
        <h3 style="margin-top: 2.5rem;">Why it needs sudo</h3>
        <p>
            Because a release ships with every dependency already compiled, and that only works
            at one fixed path. Cargo decides whether compiled code can be reused by fingerprints
            that contain absolute paths. A cache warmed at one path and read from another is
            thrown away, and the first program you build recompiles five hundred crates instead
            of using the ones you just downloaded. Installing everywhere means installing at the
            same place everywhere, and <code>/opt</code> is where a machine keeps software that
            did not come from its package manager.
        </p>
        <p>What one path buys, beyond the cache being real:</p>
        <ul class="point-list">
            <li><strong>nail on PATH for everyone</strong>, through <code>/usr/local/bin</code>:
                root shells, cron jobs, build agents and accounts that never log in
                interactively</li>
            <li><strong>.nail files get their icon and their open-with entry for every account</strong>,
                not only yours</li>
            <li><strong>Gigabytes land outside your home directory</strong>, which matters where
                home is a network mount, a small partition, or something a backup copies nightly</li>
            <li><strong>One copy of a version, not one per person</strong>, on a machine where
                more than one person writes Nail</li>
        </ul>
        <p>
            The honest limit: the store belongs to whoever ran the install. Everyone on the
            machine can run what is there, but a second person who wants to add a version needs
            it handed over with <code>sudo chown -R $USER /opt/nail</code>. That is the trade for
            one shared, prebuilt toolchain rather than several private half-built ones.
        </p>
        <p>
            And if giving an installer one sudo is a line you would rather not cross, that is a
            perfectly reasonable line and Nail is not the right tool for you. Nothing here will
            try to talk you round. The alternative was a home install that quietly recompiled
            everything the toolchain had already compiled, and shipping something that pretends
            to be prebuilt is worse than asking once.
        </p>
        <p>
            <strong>nail</strong> is the only command and the only thing on your PATH. It reads
            which version a file was written for, downloads exactly that version if you do not
            have it, and opens the file. The compiler, the editor, a pinned Rust toolchain and
            every library already built come down in one piece, so the first program compiles in
            seconds and everything after that works with the network unplugged.
        </p>
        <p>
            The editor comes with it and runs the real compiler over your file as you type, so an
            error is underlined where it is instead of guessed at by a plugin:
        </p>
        <ul class="point-list">
            <li><strong>F7</strong> compiles what you are looking at in under a second, <strong>Shift+F7</strong> makes the release binary</li>
            <li><strong>F1</strong> documents the function under the cursor</li>
            <li>Ctrl+S saves, Ctrl+F finds, F6 changes the theme</li>
        </ul>
        <p>
            Nothing to configure: no language server to keep in sync, no formatter to argue about,
            no plugin that quietly disagrees with the compiler. Build scripts call that same
            compiler through <strong>nail build</strong> and <strong>nail check</strong>, at the
            version the file asked for rather than whichever is newest.
        </p>
        <p style="font-size: 0.95rem;">
            The
            <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/bundle/install.sh" style="color: var(--primary); text-decoration: underline;">install script</a>
            is there to read, though reading it proves less than it looks like: a server can
            serve one thing to a pipe and another to a browser, and what it fetches is a
            compiled toolchain either way. The claim worth having is the one you can check
            afterwards, which is that all of it is in a directory you own and deleting that
            directory is the end of it. Or skip the script and build from source with
            <code>git clone</code> and <code>cargo run</code>. Linux is the supported platform
            for the tools. The programs you build are static binaries and run anywhere.
        </p>
        <p style="font-size: 0.95rem;">
            The <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/nail_language_spec.md" target="_blank" style="color: var(--primary); text-decoration: underline;">language specification</a>
            is the full reference, and this site's own
            <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/examples/website/main.nail" target="_blank" style="color: var(--primary); text-decoration: underline;">source</a>
            is the largest Nail program there is to read.
        </p>
    </div>
</section>`;
}

f generate_ide(shot_error:s, shot_complete:s, shot_docs:s, tagged_code:s):s {
    ide_html:s = array_join([
        html`<section id="ide" class="ide">
    <div class="section-header">
        <h2>The editor is part of the language</h2>
        <p>Real frames captured from a terminal. The compiler underneath them is the same one that
           builds your program.</p>
    </div>
    <div class="philosophy-content" style="max-width: 1100px;">
        <h3>Errors appear where they are, while you type</h3>
        <div class="ide-shot"><pre>`,
        shot_error,
        html`</pre></div>
        <p class="ide-caption">
            The editor runs the real lexer, parser and type checker as you edit, and marks the
            problem on the line that caused it. There is one implementation of the language, and
            this is it.
        </p>

        <h3>Completions come from the standard library, with signatures</h3>
        <div class="ide-shot"><pre>`,
        shot_complete,
        html`</pre></div>
        <p class="ide-caption">
            Every function ships with the language, so the editor offers all of them with full
            types. No index to build, nothing to keep in sync.
        </p>

        <h3>Embedded languages stay readable</h3>
        <div class="code-example"><span class="code-label">Nail</span><pre>`,
        tagged_code,
        html`</pre></div>
        <p class="ide-caption">
            A web program is mostly long strings of other languages. Tag one with what it holds -
            <code>html\`&lt;p&gt;hi&lt;/p&gt;\`</code>, or <code>css</code>, <code>sql</code>,
            <code>yaml</code> - and the editor and this page both colour it as that language. The
            colouring keeps its place across line breaks, so an open <code>&lt;div</code>, a CSS
            block or a <code>/* ... */</code> still reads correctly on the next line.
        </p>
        <p class="ide-caption">
            The tag means nothing to the compiler: same type, same escapes, same Rust out the
            other end. It is a note to whoever is reading. The tags both highlighters know:
        </p>
        <div class="lang-tags">
            <div class="lang-row"><span class="lang-name">Markup</span><span class="lang-list"><code>html</code> <code>htm</code> <code>xhtml</code> <code>svg</code> <code>xml</code> <code>rss</code> <code>atom</code></span></div>
            <div class="lang-row"><span class="lang-name">Stylesheets</span><span class="lang-list"><code>css</code> <code>scss</code> <code>sass</code> <code>less</code></span></div>
            <div class="lang-row"><span class="lang-name">JavaScript</span><span class="lang-list"><code>js</code> <code>javascript</code> <code>mjs</code> <code>cjs</code> <code>jsx</code> <code>ts</code> <code>typescript</code> <code>tsx</code> <code>json</code> <code>jsonc</code></span></div>
            <div class="lang-row"><span class="lang-name">SQL</span><span class="lang-list"><code>sql</code> <code>postgres</code> <code>postgresql</code> <code>mysql</code> <code>sqlite</code></span></div>
            <div class="lang-row"><span class="lang-name">Shell</span><span class="lang-list"><code>sh</code> <code>bash</code> <code>zsh</code> <code>shell</code> <code>dockerfile</code></span></div>
            <div class="lang-row"><span class="lang-name">Languages</span><span class="lang-list"><code>py</code> <code>rb</code> <code>rs</code> <code>go</code> <code>java</code> <code>cs</code> <code>c</code> <code>cpp</code> <code>php</code> <code>swift</code> <code>kt</code> <code>lua</code> <code>graphql</code></span></div>
            <div class="lang-row"><span class="lang-name">Shaders</span><span class="lang-list"><code>wgsl</code></span></div>
            <div class="lang-row"><span class="lang-name">Configuration</span><span class="lang-list"><code>yaml</code> <code>yml</code> <code>toml</code> <code>ini</code> <code>cfg</code> <code>conf</code> <code>properties</code></span></div>
            <div class="lang-row"><span class="lang-name">Prose</span><span class="lang-list"><code>md</code> <code>markdown</code></span></div>
        </div>
        <p class="ide-caption">
            The compiler keeps no list of languages, so a tag from outside this table still
            compiles, its string simply keeps one plain colour. Nothing here is a plugin: one
            scanner covers everything built out of words, strings and comments, and each language
            is a row in its table.
        </p>

        <h3>F1 documents whatever is under the cursor</h3>
        <div class="ide-shot"><pre>`,
        shot_docs,
        html`</pre></div>
        <p class="ide-caption">
            Documentation lives in the registry the compiler type checks against, so it cannot
            drift out of date.
        </p>
    </div>
</section>`
    ], ``);
    r ide_html;
}

f generate_performance():s {
    r html`<section id="performance" class="performance">
    <div class="section-header">
        <h2>Performance overview</h2>
        <p>What runs in parallel automatically, and what it measures out to</p>
    </div>
    <div class="philosophy-content">
        <div class="perf-card">
            <p style="margin-bottom: 0.75rem;"><strong>Uses every core, automatically:</strong></p>
            <ul class="point-list">
                <li><strong>map</strong> and <strong>filter</strong>: spread across all cores</li>
                <li><strong>find</strong>, <strong>all</strong>, <strong>any</strong>: every core searches, everyone stops at the answer</li>
                <li><strong>sum</strong>, <strong>min</strong>, <strong>max</strong>: split across cores once the array is big enough to be worth it</li>
                <li><strong>p blocks</strong>: one real thread per statement, for CPU work</li>
                <li><strong>c blocks</strong>: three file reads take as long as the slowest one, instead of all three added together</li>
                <li><strong>reduce</strong>: only when the compiler can prove it is safe, below</li>
            </ul>
            <p style="margin: 0.75rem 0 0 0;"><strong>Never:</strong> <strong>each</strong>, whose
                side effects happen in the order you wrote them, and <strong>scan</strong>, where
                every value depends on the ones before it.</p>
        </div>

        <p style="margin-top: 2rem;">
            A hand-written loop is opaque, so it runs in order. A named operation carries its own
            rules: <strong>sum</strong> says order does not matter, which is what lets it spread
            across cores.
        </p>
        <p>
            <strong>reduce</strong> parallelizes only where regrouping cannot change the answer:
            integer addition and multiplication, min, max. Subtraction, division and floats stay in
            order, with no flag to override it, because a wrong promise is a silently wrong number.
        </p>
        <p>
            Threads are not free, so parallelism switches on above a measured size:
        </p>
        <div class="bench-wrap">
            <table class="bench-table">
                <tr>
                    <th>Elements</th>
                    <th>min / max</th>
                    <th>sum</th>
                </tr>
                <tr>
                    <td>200,000</td>
                    <td>0.42x (slower)</td>
                    <td>slower</td>
                </tr>
                <tr>
                    <td>1,000,000</td>
                    <td class="bench-win">1.23x</td>
                    <td>0.63x (slower)</td>
                </tr>
                <tr>
                    <td>4,000,000</td>
                    <td class="bench-win">2.64x</td>
                    <td class="bench-win">1.98x</td>
                </tr>
            </table>
        </div>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">
            24-core machine, i64 elements: the cheapest case, so the hardest to win. Costlier
            comparisons cross over sooner (minimum of a million strings is 2.69x at a fifth of that
            size). On one core Nail skips the parallel path entirely.
        </p>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">
            Microbenchmarks of single operations, not whole programs. Most software waits on I/O
            and gains nothing here, where Nail emits the sequential Rust you would have written
            anyway.
        </p>
        <div class="bench-wrap">
            <table class="bench-table">
                <tr>
                    <th>Workload</th>
                    <th>Hand-written sequential Rust</th>
                    <th>Nail</th>
                </tr>
                <tr>
                    <td>Primes below 50,000 by trial division (CPU-heavy filter)</td>
                    <td>132 ms</td>
                    <td class="bench-win">12 ms (11x faster)</td>
                </tr>
                <tr>
                    <td>Doubling 1,000,000 integers (trivial per-element work)</td>
                    <td>&lt;1 ms</td>
                    <td>1 ms (same)</td>
                </tr>
            </table>
        </div>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">
            24-core Linux machine, both built with --release. Hand-written Rust runs on one core
            unless you parallelize it yourself. Nail spreads across the rest when the work
            justifies it.
        </p>
    </div>
</section>`;
}

f generate_profiling(shot_timings:s):s {
    r array_join([html`<section id="profiling" class="performance">
    <div class="section-header">
        <h2>The server profiles itself</h2>
        <p>Every build times every function, with nothing turned on</p>
    </div>
    <div class="philosophy-content">
        <p>
            Not a benchmark: the live profiler dump of the Nail program serving you this page,
            every function it has run since it started, counted and timed, refreshed as you watch.
            Recording a call costs about 30 nanoseconds, and <code>nailc --no-profile</code> builds
            without it.
        </p>
        <div id="profile-live" hx-get="/profile-live" hx-trigger="intersect once, every 2s [nailProfileWatched(this)]" hx-swap="innerHTML">
            <p style="opacity: 0.7;">Reading the profiler dump...</p>
        </div>
        <script>
// This table is the only thing on the site that asks the server for work on a
// timer, and building it is by far the busiest thing the server does. So the
// timer only fires while a reader can actually see the table: not in a
// background tab, not while the section is scrolled off screen. A page left
// open on another section costs the server nothing.
function nailProfileWatched(pane) {
    if (document.visibilityState !== 'visible') { return false; }
    var box = pane.getBoundingClientRect();
    return box.bottom > 0 && box.top < window.innerHeight;
}
        </script>
        <h3 style="margin-top: 2.5rem;">The same numbers, pinned in the IDE</h3>
        <div class="ide-shot"><pre>`,
        shot_timings,
        html`</pre></div>
        <p class="ide-caption">
            A real frame from the editor. Each function wears its last run's timings: total, share
            of wall time, average with call count, max. Edit the file and they dim as stale until
            the next run.
        </p>
        <h3 style="margin-top: 2.5rem;">And every run answers on the way out</h3>
        <div class="code-example"><span class="code-label">a program closing, printed by itself</span><pre>── nail timing sheet ──
function               calls      total        avg        max       %
is_prime                9998    419.0ms     41.9µs     13.9ms  2304.3%
count_primes_below         1     18.2ms     18.2ms     18.2ms   99.8%
factorial                 12      5.2µs      437ns      781ns    0.0%
program wall time 18.2ms, it could run 55.0 times a second. Times are cumulative, a caller includes its callees. A share over 100% means that function ran on several cores at once.</pre></div>
        <p class="ide-caption">
            Real output from examples/profiling_demo.nail. The last line is the whole program as
            one number: over 60 runs a second reads as instant, single digits as sluggish. The
            2304% share is is_prime running across every core at once, parallelized by the
            compiler. Games close with one more line, like
            <code>56 fps shown, 513 fps possible, 1.95ms of real work per frame</code>.
        </p>
    </div>
</section>`], ``);
}

// Versioning is the part of Nail that readers say they cannot picture, so this
// section is written as a walkthrough rather than a summary: a real file, the
// real terminal output of each command, and a table of exactly what changed on
// disk. "Move a file to a newer version" means one thing, and it is spelled out
// rather than implied.
f generate_versioning():s {
    r html`<section id="versioning" class="philosophy">
    <div class="section-header">
        <h2>Programs that don't rot</h2>
        <p>A file says which Nail wrote it, and that is the Nail that compiles it. Forever</p>
    </div>
    <div class="philosophy-content">
        <p>
            Line one of every Nail file names the compiler that wrote it. It is part of the file,
            so it travels wherever the file goes: into git, into a zip, onto a laptop five years
            from now.
        </p>
        <div class="code-example" style="margin: 1.5rem 0;"><span class="code-label">my_app.nail</span><pre>nail 0.1.0

total:i = array_sum([3, 4, 5]);
print(string_from(total));</pre></div>
        <p>
            The command that runs it never mentions a version. nail reads line one, makes sure that
            exact compiler is on the machine, downloads it if it is not, and hands the file over.
        </p>
        <div class="code-example" style="margin: 1.5rem 0;"><span class="code-label">Terminal, the first time this machine sees 0.1.0</span><pre>$ nail run my_app.nail
nail: 0.1.0 is not installed, fetching it
  Nail 0.1.0 [████████████████████████] 100%  774.2 MB / 774.2 MB  22.4 MB/s
unpacking
Nail 0.1.0 installed
12</pre></div>
        <p>
            The 12 on the last line is the program's own output: array_sum([3, 4, 5]) is 12.
            The install happened on the way to running the file, not as a step of its own.
        </p>
        <p>
            The nail on your PATH is not the compiler. It is a small program that owns the set of
            installed versions and picks one per file. Versions sit side by side in a directory
            you own and never see each other, so opening an old file installs the
            compiler that file asks for and changes nothing about any other file on the machine.
            There is no global default to move and no project to migrate first.
        </p>
        <h3 style="margin-top: 2.5rem;">Why the version number is the whole lock file</h3>
        <p>
            Elsewhere a compiler version is the start of the story, and a lock file carries the
            hundreds of package versions it does not pin. Nail has no package manager and a closed
            set of libraries, all shipped inside the release, already vendored and built. Pin the
            compiler and every byte underneath it is pinned too. Nothing is resolved at build time,
            so there is nothing left to write down.
        </p>
        <h3 style="margin-top: 2.5rem;">The three states of line one</h3>
        <div class="release-wrap"><table class="release-table">
            <thead><tr><th>Line one</th><th>What happens</th><th>Who writes it</th></tr></thead>
            <tbody>
                <tr>
                    <td><code>nail 0.1.0</code></td>
                    <td>Compiled by 0.1.0 and nothing else, today and in ten years</td>
                    <td>The editor, on save. <code>nail new</code>, on create</td>
                </tr>
                <tr>
                    <td><code>nail latest</code></td>
                    <td>Not settled yet. Every open asks what the newest release is, and fetches it
                        if it is new</td>
                    <td>You, by hand, for code you are still writing</td>
                </tr>
                <tr>
                    <td>Missing</td>
                    <td>An error. The compiler refuses a file that has not said what built it</td>
                    <td>Nobody</td>
                </tr>
            </tbody>
        </table></div>
        <p>
            No ranges, no carets, no "any 0.3.x". A range means the same file compiling differently
            next year, which is the drift this exists to prevent, so the grammar cannot express
            one. The missing line is an error for the same reason: any default would quietly mean
            "whatever is newest".
        </p>
        <h3 style="margin-top: 2.5rem;">nail which: what compiles this file, and why</h3>
        <p>
            Resolution is never a guess you have to make. Ask, and you get the version, the reason
            it was chosen, and the exact binary that would run.
        </p>
        <div class="code-example" style="margin: 1.5rem 0;"><span class="code-label">Terminal</span><pre>$ nail which my_app.nail
my_app.nail pins 0.1.0
/opt/nail/versions/0.1.0/bin/nail

$ nail which work_in_progress.nail
work_in_progress.nail says \`nail latest\`, newest installed is 0.1.1
/opt/nail/versions/0.1.1/bin/nail</pre></div>
        <h3 style="margin-top: 2.5rem;">nail fetch: take a whole project offline</h3>
        <p>
            A checkout can pin several versions at once, because one file was frozen last year and
            another moved last week. nail fetch walks a directory, reads line one of every Nail
            file under it, and installs every version it finds. When it finishes, every file in
            that tree opens with the network unplugged.
        </p>
        <div class="code-example" style="margin: 1.5rem 0;"><span class="code-label">Terminal</span><pre>$ nail fetch .
41 Nail files, pinning 2 version(s), 1 missing
  Nail 0.1.1 [████████████████████████] 100%  800.2 MB / 800.2 MB  22.4 MB/s
unpacking
Nail 0.1.1 installed

$ nail fetch .
41 Nail files, pinning 2 version(s), 0 missing
nothing to fetch</pre></div>
        <h3 style="margin-top: 2.5rem;">nail update: moving a file forward</h3>
        <p>
            Moving a file to a newer Nail means exactly one thing: rewriting line one. The rest of
            the file is untouched, and no other file is affected. Nothing does this on its own. A
            pinned file is compiled by its pin and by nothing else, even when a newer compiler
            would accept it, because compiling cleanly is not proof the program still behaves
            exactly as it was written. There is no auto upgrade path, only an edit you asked for.
        </p>
        <p>
            nail update installs the version being moved to, compiles each file against it, and
            rewrites line one only for the files that pass. The check is a filter, not a
            guarantee: it stops the files the new version rejects outright. A file that fails
            keeps the line it had and keeps working, exactly as it did before the command ran.
            The files that do move are yours to test under their new pin.
        </p>
        <p>
            Without --yes nothing is written. It is a list of what would be attempted.
        </p>
        <div class="code-example" style="margin: 1.5rem 0;"><span class="code-label">Terminal</span><pre>$ nail update .
3 file(s) would move to 0.1.1
  ./main.nail
  ./my_app.nail
  ./my_old_app.nail

nothing changed. Add --yes to check each file and restamp the ones that pass

$ nail update . --yes
3 file(s) would move to 0.1.1
2 file(s) moved to 0.1.1
1 file(s) do not compile under 0.1.1 and were left alone:
  ./my_old_app.nail</pre></div>
        <p>And on disk, that is the whole of it:</p>
        <div class="release-wrap"><table class="release-table">
            <thead><tr><th>File</th><th>Line one before</th><th>Line one after</th><th>Why</th></tr></thead>
            <tbody>
                <tr>
                    <td><code>main.nail</code></td>
                    <td><code>nail 0.1.0</code></td>
                    <td><code>nail 0.1.1</code></td>
                    <td>Compiles under 0.1.1, so the move you asked for went ahead</td>
                </tr>
                <tr>
                    <td><code>my_app.nail</code></td>
                    <td><code>nail 0.1.0</code></td>
                    <td><code>nail 0.1.1</code></td>
                    <td>Compiles under 0.1.1, so the move you asked for went ahead</td>
                </tr>
                <tr>
                    <td><code>my_old_app.nail</code></td>
                    <td><code>nail 0.1.0</code></td>
                    <td><code>nail 0.1.0</code></td>
                    <td>0.1.1 rejects it, so the move was refused. Line one untouched, and it
                        opens with 0.1.0 exactly as before</td>
                </tr>
                <tr>
                    <td><code>work_in_progress.nail</code></td>
                    <td><code>nail latest</code></td>
                    <td><code>nail latest</code></td>
                    <td>Tracks the newest release already, so there is nothing to move</td>
                </tr>
            </tbody>
        </table></div>
        <p>
            my_old_app.nail is not a problem to be solved before the others can move. Fix it and run
            the command again, or leave it on 0.1.0 for as long as it is useful. Migration is a
            per-file choice, and it is always a choice. <code>--to=0.1.4</code> moves to a named
            version rather than the newest installed one.
        </p>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">
            A release is one file on one box, served over HTTPS, and a version number names exactly
            one of them. No index to go stale, no registry to resolve against.
        </p>
    </div>
</section>`;
}

f generate_mcp(mcp_source:s):s {
    r array_join([
        html`<section id="mcp" class="examples">
    <div class="section-header">
        <h2>Instant MCP server</h2>
        <p>The Model Context Protocol is how AI assistants call outside tools. In Nail it is a tool list and one function.</p>
    </div>
    <div class="code-example" style="position: relative;">
        <span class="code-label">Nail</span>
        <pre>`,
        mcp_source,
        html`</pre>
    </div>
    <p style="color: var(--text-secondary); margin-top: 1rem;">
        Declare the tools, write handle_tool, call mcp_serve. One command compiles this file into
        a static binary that plugs into Claude Code or Claude Desktop, with no runtime to install
        and no dependencies to resolve. Stdout carries the protocol, the log functions write to
        stderr so they stay out of its way, and an error you return becomes a tool error the model
        can act on. Elsewhere this is a Node or Python project with a package manager in front of
        it. Here it is a file.
    </p>
</section>`
    ], ``);
}


// The library list is not written here: the server asks the compiler what it
// can call and prints the answer, so this section is the standard library of
// the compiler that built this page, not a list someone kept up to date.
// The import section: a real break-in attempt and the real refusal.
// The three values arrive precomputed: the two files highlighted, and the
// verdict this server got from its own compiler at startup.
f generate_import_section(helper_html:s, entry_html:s, verdict_html:s):s {
    values:h<s,s> = hashmap_new();
    hashmap_set(values, `helper`, helper_html);
    hashmap_set(values, `entry`, entry_html);
    hashmap_set(values, `verdict`, verdict_html);
    r danger(template_render(html`<section id="sandbox" class="sandbox">
    <div class="section-header">
        <h2>Use a stranger's code safely</h2>
        <p>import pulls a file into your program and sandboxes it: it can compute anything and touch nothing</p>
    </div>
    <div class="sandbox-points">
        <span class="sandbox-point">No network</span>
        <span class="sandbox-point">No disk</span>
        <span class="sandbox-point">No environment</span>
        <span class="sandbox-point">No processes</span>
        <span class="sandbox-point">No global state</span>
        <span class="sandbox-point">Zero runtime cost</span>
    </div>
    <div class="sandbox-grid">
        <div class="code-example sandbox-code">
            <span class="code-label">A file from the internet</span>
            <pre>{{{helper}}}</pre>
        </div>
        <div class="code-example sandbox-code">
            <span class="code-label">Your program</span>
            <pre>{{{entry}}}</pre>
        </div>
    </div>
    <div class="code-example sandbox-verdict">
        <span class="code-label">The compiler's answer</span>
        <pre>{{{verdict}}}</pre>
    </div>
    <p class="sandbox-note">
        Not a mock: at startup this server handed the two files above to its own compiler and
        printed the refusal it got back. The sandbox holds through every function the file
        reaches, so nothing gets laundered through a helper.
    </p>
    <p class="sandbox-note">
        import is the default, so a stranger's file never needs your trust. import_dangerous is
        for your own files and trusts them completely, which is why its name makes you say so. A
        package repository for Nail would be a shelf of plain files imported like this: nothing to
        resolve, nothing to lock.
    </p>
</section>`, values));
}

// The front page carries only a teaser: the listing itself is huge, so it
// lives on its own page at /stdlib.
f generate_stdlib_teaser(function_count:i, module_count:i, rows:a:h<s,s>):s {
    entries:s = danger(template_render_rows(html`<div class="stdlib-fn battery-row"><code class="stdlib-sig">{{expression}}</code><code class="battery-answer">{{answer}}</code></div>`, rows));
    values:h<s,s> = hashmap_new();
    hashmap_set(values, `function_count`, string_from(function_count));
    hashmap_set(values, `module_count`, string_from(module_count));
    hashmap_set(values, `entries`, entries);
    r danger(template_render(html`<section id="stdlib" class="stdlib">
    <style>.battery-row { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; align-items: baseline; padding: 0.5rem 0; } .battery-answer { color: var(--success); font-weight: 600; }</style>
    <div class="section-header">
        <h2>Standard library</h2>
        <p>{{function_count}} functions across {{module_count}} modules, all built in. This server computed every answer below at startup, by running the expression on its left</p>
    </div>
    {{{entries}}}
    <div class="stdlib-controls" style="margin-top: 2rem;">
        <a href="/stdlib" class="btn btn-primary">Browse standard library</a>
    </div>
</section>`, values));
}

// The full listing, served as its own page at /stdlib.
f generate_stdlib_page(page_title:s, page_description:s, functions:a:STDLIB_Function, modules:a:s):s {
    // One pass over the list buckets every function under its module, where
    // filtering inside the loop below walked the whole list once per module.
    by_module:h<s,a:STDLIB_Function> = array_group_by(functions, stdlib_function_module);

    module_blocks:a:s = map module_name in modules {
        module_functions:a:STDLIB_Function = safe(hashmap_get(by_module, module_name), no_functions);

        rows:a:h<s,s> = map function in module_functions {
            row:h<s,s> = hashmap_new();
            hashmap_set(row, `signature`, function.signature);
            hashmap_set(row, `description`, function.description);
            y row;
        };
        // The template escapes both values on the way in, so nothing here has to
        // remember to call code_escape_html.
        entries:s = danger(template_render_rows(html`<div class="stdlib-fn"><code class="stdlib-sig">{{signature}}</code><p class="stdlib-desc">{{description}}</p></div>`, rows));

        block_values:h<s,s> = hashmap_new();
        hashmap_set(block_values, `module`, module_name);
        hashmap_set(block_values, `count`, string_from(array_length(module_functions)));
        hashmap_set(block_values, `entries`, entries);
        y danger(template_render(html`<details class="stdlib-module"><summary><code class="stdlib-module-name">{{module}}</code> <span class="stdlib-count">{{count}} functions</span></summary>{{{entries}}}</details>`, block_values));
    };

    section_values:h<s,s> = hashmap_new();
    hashmap_set(section_values, `function_count`, string_from(array_length(functions)));
    hashmap_set(section_values, `module_count`, string_from(array_length(modules)));
    hashmap_set(section_values, `modules`, array_join(module_blocks, ``));

    listing:s = danger(template_render(html`<section id="stdlib" class="stdlib">
    <div class="section-header">
        <h2>Standard library</h2>
        <p>{{function_count}} functions across {{module_count}} modules, all built in</p>
    </div>
    <p class="stdlib-intro">
        No package manager: what ships with the compiler is what you can call. This page asked the
        compiler serving it for the list, so it cannot be out of date. Need something that is not
        here? Copy it in, that is the whole installation, and what everyone keeps reaching for
        gets added to this list.
    </p>
    <div class="stdlib-controls">
        <button class="btn btn-secondary stdlib-toggle" onclick="var open=this.dataset.open!=='1';document.querySelectorAll('#stdlib .stdlib-module').forEach(function(d){d.open=open});this.dataset.open=open?'1':'0';this.textContent=open?'Collapse all':'Expand all'">Expand all</button>
    </div>
    {{{modules}}}
</section>`, section_values));

    r array_join([
        generate_head(page_title, page_description),
        html`<body>`,
        html`<nav class="navbar">
    <div class="nav-container">
        <a href="/" class="nav-brand">
            <span style="font-size: 1.5rem;">🔨</span>
            <span>Nail</span>
        </a>
        <div class="nav-links"><a href="/" class="nav-link">Back to the home page</a></div>
    </div>
</nav>`,
        listing,
        generate_footer(),
        html`</body>
</html>`
    ], ``);
}

f generate_author(avatar_base64:s):s {
    author_html:s = array_join([
        html`<section id="author" class="author">
    <div class="section-header">
        <h2>Made by</h2>
    </div>
    <div class="author-card">
        <img class="author-photo" src="data:image/jpeg;base64,`,
        avatar_base64,
        `" alt="Alex Wilkinson">
        <p class="author-name">Alex Wilkinson</p>
        <p>
            Most bugs I have shipped were simple problems buried under features I did not need: a
            null, a variable something else changed, an off-by-one, two threads on the same value.
            Nail drops those features instead of giving me better tools for surviving them.
        </p>
        <p>
            One command turned this page into the server you are reading it from. I also made
            <a href="https://sul.alex-wilkinson.ca" target="_blank">Simple Universal Language</a>,
            a spoken and written language built to still reach people who cannot see or hear it.
        </p>
    </div>
</section>`
    ], ``);
    r author_html;
}

f generate_footer():s {
    r html`<footer class="site-footer">
    <div class="footer-inner">
        <p class="footer-note">
            Made with Nail 🔨. This page is a Nail program.
        </p>
        <div class="footer-links">
            <a href="https://github.com/AlexTDWilkinson/Nail" target="_blank">
                GitHub
            </a>
            <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/nail_language_spec.md" target="_blank">
                Documentation
            </a>
        </div>
    </div>
</footer>`;
}

// The hamburger. Every listener is on `document` rather than on the button:
// the page is boosted by htmx, which replaces the body on navigation, and a
// listener bound to the nav itself would go with it.
// Makes the three refusal panes editable, checked by the real compiler
// compiled to WebAssembly (playground_wasm/, served from /wasm). Fix the
// bug and the verdict flips: that section's payoff is the compiler's
// answer, so it works completely client side. The example panes stay
// read-only on purpose: their payoff is run output, which nothing can
// produce for edited code until an interpreter exists. Purely structural,
// it finds the panes by classes they already carry. The wasm loads on
// first focus, visitors who only read pay nothing.
f generate_playground_script():s {
    behavior:s = js`
    let compiler = null;
    let loading = null;
    const loadCompiler = () => {
        if (!loading) {
            loading = import('/wasm/playground/pkg/playground_wasm.js')
                .then(mod => mod.default().then(() => { compiler = mod.playground_review; }))
                .catch(() => { loading = null; });
        }
        return loading;
    };
    const wire = (editor, onResult) => {
        editor.contentEditable = 'plaintext-only';
        if (!editor.isContentEditable) { editor.contentEditable = 'true'; }
        editor.spellcheck = false;
        editor.title = 'Editable. Type here and the compiler, running in this page, answers.';
        let timer = null;
        const refresh = () => {
            if (!compiler) { return; }
            onResult(JSON.parse(compiler(editor.innerText)));
        };
        editor.addEventListener('focus', () => { loadCompiler().then(refresh); });
        editor.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(refresh, 250);
        });
        editor.addEventListener('blur', () => {
            if (!compiler) { return; }
            const result = JSON.parse(compiler(editor.innerText));
            if (result.ok && result.highlighted) { editor.innerHTML = result.highlighted; }
        });
    };
    document.querySelectorAll('.refusal-pane').forEach(pane => {
        const editor = pane.querySelector('.sandbox-code pre');
        const verdictPane = pane.querySelector('.sandbox-verdict pre');
        if (!editor || !verdictPane) { return; }
        wire(editor, result => {
            verdictPane.textContent = result.ok ? 'Compiles clean. You fixed it.' : result.verdict;
        });
    });
`;
    r array_join([html`<script type="module">`, behavior, html`</script>`], ``);
}

f generate_menu_script():s {
    r html`<script>
(function () {
    var BREAKPOINT = 900;

    function setOpen(open) {
        var links = document.getElementById('nav-links');
        var button = document.querySelector('.nav-toggle');
        if (!links || !button) { return; }
        links.classList.toggle('open', open);
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        var openIcon = button.querySelector('.nav-icon-open');
        var closeIcon = button.querySelector('.nav-icon-close');
        if (openIcon && closeIcon) {
            openIcon.style.display = open ? 'none' : '';
            closeIcon.style.display = open ? '' : 'none';
        }
    }

    document.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) { return; }
        var links = document.getElementById('nav-links');
        if (target.closest('.nav-toggle')) {
            setOpen(!(links && links.classList.contains('open')));
            return;
        }
        // Every link is an anchor on this one page, so the panel has to close
        // itself: the URL changes but nothing reloads.
        if (target.closest('.nav-link')) {
            setOpen(false);
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') { setOpen(false); }
    });

    // Widening past the breakpoint hides the panel in CSS, but the button
    // would still claim it is open.
    window.addEventListener('resize', function () {
        if (window.innerWidth > BREAKPOINT) { setOpen(false); }
    });
})();
</script>`;
}

// The browser games. Each demo is a Nail program compiled to WebAssembly
// with nailc --target=wasm. A demo lives on a minimal embed page that the
// home page frames: the frame gives each game its own base URL (so the
// program's relative fetch paths resolve into the /wasm mount), its own
// canvas, and its own keyboard focus, so a game only hears keys once it is
// clicked and never steals scrolling from the page around it.

f generate_game_embed_page(page_title:s, module_src:s):s {
    values:h<s,s> = hashmap_new();
    hashmap_set(values, `title`, page_title);
    hashmap_set(values, `module_src`, module_src);
    r danger(template_render(html`<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <base href="/wasm/">
    <style>
        html, body { margin: 0; height: 100%; background: #0f1117; }
        body { display: flex; align-items: center; justify-content: center; }
        canvas { max-width: 100%; max-height: 100vh; }
    </style>
</head>
<body>
    <canvas id="nail-game"></canvas>
    <script type="module">import init from '{{{module_src}}}'; await init();</script>
</body>
</html>`, values));
}

f generate_games_section():s {
    r html`<section id="games" class="section">
    <div class="section-header">
        <h2>Games, compiled to your browser</h2>
        <p>
            Every frame below is a Nail program, built with <code>nailc --target=wasm</code>. The
            same source files open native windows on a desktop. Click a game to give it your
            keyboard.
        </p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 2.5rem; align-items: center;">
        <div style="width: 100%; max-width: 940px;">
            <h3 style="margin: 0 0 0.5rem 0;">Platformer</h3>
            <p style="margin: 0 0 0.75rem 0; opacity: 0.8;">
                Click it, then arrows or A and D move, Space jumps, R restarts the level. On a
                phone, the corner pads. Five levels of pits, coins, spikes and things that walk
                and fly, all pure functions over one struct, with sound. Every rectangle, circle
                and glyph is an instanced quad your graphics card draws through WebGL2, with the
                CPU rasterizer as the fallback.
                <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/examples/platformer.nail" target="_blank" style="color: var(--primary); text-decoration: underline;">Read its source →</a>
            </p>
            <iframe src="/games/platformer-embed" title="Platformer written in Nail" style="width: 100%; aspect-ratio: 800 / 600; border: 1px solid var(--border); border-radius: 0.75rem; background: #101018;"></iframe>
        </div>
        <div style="width: 100%; max-width: 940px;">
            <h3 style="margin: 0 0 0.5rem 0;">3D model viewer</h3>
            <p style="margin: 0 0 0.75rem 0; opacity: 0.8;">
                Drag to orbit, scroll to zoom, or drag and pinch on a phone. The monument is a
                glTF file the program fetches, projected and lit by the standard library on the
                CPU: no JavaScript renderer, every triangle placed by your program.
                <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/examples/model_viewer.nail" target="_blank" style="color: var(--primary); text-decoration: underline;">Read its source →</a>
            </p>
            <iframe src="/games/viewer-embed" title="3D model viewer written in Nail" style="width: 100%; aspect-ratio: 900 / 640; border: 1px solid var(--border); border-radius: 0.75rem; background: #101018;"></iframe>
        </div>
        <div style="width: 100%; max-width: 940px;">
            <h3 style="margin: 0 0 0.5rem 0;">Monolith field, on the graphics card</h3>
            <p style="margin: 0 0 0.75rem 0; opacity: 0.8;">
                Drag to orbit, scroll to zoom, click a tower to claim it. One scene shape holding
                an island of towers in a rolling ocean: instanced draws, a real depth buffer,
                fog, mouse picking, and real-time lighting - the glowing orb is the sun, and
                every face relights as it circles - rendered by your graphics card through
                WebGL2. The sun's fire and the rolling water are WGSL shaders the program
                itself carries as strings and loads through game3d_shader, compiled and
                checked the moment they load. The same program opens a native window on
                Vulkan. When no card answers, the same scene falls back to the CPU.
                <a href="https://github.com/AlexTDWilkinson/Nail/blob/main/examples/monolith_field.nail" target="_blank" style="color: var(--primary); text-decoration: underline;">Read its source →</a>
            </p>
            <iframe src="/games/monolith-embed" title="GPU rendered 3D scene written in Nail" style="width: 100%; aspect-ratio: 900 / 640; border: 1px solid var(--border); border-radius: 0.75rem; background: #101018;"></iframe>
        </div>
    </div>
</section>`;
}

// One release, as a row: version, size, date, and a direct link. The list
// comes from deploy/releases.sh, which writes it at publish time because this
// server is sandboxed away from the directory the releases live in.
//
// The link opts out of hx-boost, and has to. Every page here is served inside
// <body hx-boost="true">, so htmx turns a click on any local link into a
// request it swaps into the page. That is right for pages and wrong for a
// release: it fetched eight hundred megabytes into memory and put none of it
// on disk, and the click looked like it had done nothing at all.
f release_row(line:s, newest:s):s {
    fields:a:s = string_split(line, `\t`);
    version:s = safe(array_get(fields, 0), missing_field);
    bytes_text:s = safe(array_get(fields, 1), missing_field);
    date:s = safe(array_get(fields, 2), missing_field);
    megabytes:i = safe(int_from(bytes_text), zero_size) / 1048576;

    marker:s = if {
        version == newest -> { r html`<span class="release-latest">latest</span>`; },
        else -> { r ``; }
    };

    values:h<s,s> = hashmap_new();
    hashmap_set(values, `version`, version);
    hashmap_set(values, `size`, string_from(megabytes));
    hashmap_set(values, `date`, date);
    hashmap_set(values, `marker`, marker);
    r danger(template_render(html`<tr>
        <td><code>{{version}}</code> {{{marker}}}</td>
        <td>{{date}}</td>
        <td>{{size}} MB</td>
        <td class="release-file"><a href="/versions/{{version}}/x86_64-linux" hx-boost="false" download="nail-{{version}}-linux-x86_64.tar.xz">nail-{{version}}-linux-x86_64.tar.xz</a></td>
    </tr>`, values));
}

f missing_field(err:e):s {
    r `?`;
}

f zero_size(err:e):i {
    r 0;
}

f generate_downloads_page(releases_tsv:s, nav_html:s):s {
    lines:a:s = filter line in string_split(releases_tsv, `\n`) {
        y string_trim(line) != ``;
    };
    first_line:s = safe(array_get(lines, 0), no_line);
    newest:s = safe(array_get(string_split(first_line, `\t`), 0), missing_field);

    rows:s = array_join(map line in lines { y release_row(line, newest); }, ``);

    body:s = if {
        array_length(lines) == 0 -> { r html`<p>No releases published yet.</p>`; },
        else -> { r array_join([html`<div class="release-wrap"><table class="release-table">
            <thead><tr><th>Version</th><th>Published</th><th>Size</th><th>File</th></tr></thead>
            <tbody>`, rows, html`</tbody>
        </table></div>`], ``); }
    };

    // Every version this page names is the newest published one, read from the
    // same list the table is built from. A number typed into the copy would go
    // stale on the next release and nothing would notice.
    example:s = if {
        array_length(lines) == 0 -> { r `latest`; },
        else -> { r newest; }
    };

    values:h<s,s> = hashmap_new();
    hashmap_set(values, `rows`, body);
    hashmap_set(values, `example`, example);
    section:s = danger(template_render(html`<section class="philosophy">
    <div class="section-header">
        <h2>Downloads</h2>
        <p>You do not normally need this page. nail fetches the version a file asks for, by itself</p>
    </div>
    <div class="philosophy-content">
        <div class="code-example"><span class="code-label">Shell</span><pre>curl -fsSL https://nail.alex-wilkinson.ca/install | sudo sh

# Opens the file in Nail's own IDE
nail hello.nail</pre></div>
        <p>
            Install this and stop. nail is a launcher: it reads the version on a file's first
            line, fetches exactly that version, keeps them side by side and hands the file to the
            right one. Nothing below this line is something you should have to do.
            <a href="/#start">Get started</a> has the rest.
        </p>
        <h3>A version, by name</h3>
        <p>Same fetch, you just say when.</p>
        <div class="code-example"><span class="code-label">Shell</span><pre>nail install {{example}}</pre></div>
        <h3>A version, as a file</h3>
        <p>
            For the machine with no network. Download it here, carry it over, install it from
            the file. You never unpack it yourself, and the name does not matter: nail reads the
            version out of the file.
        </p>
        {{{rows}}}
        <div class="code-example"><span class="code-label">Shell</span><pre>nail import nail-{{example}}-linux-x86_64.tar.xz</pre></div>
        <p style="font-size: 0.95rem; margin-top: 1.5rem;">
            Each one is a whole toolchain, compiler and editor and Rust and every library already
            built, which is why they are large and why nothing else has to be on the machine.
            Linux x86_64, on a glibc distribution (Ubuntu, Debian, Fedora, Arch). The programs you
            build are static binaries and run anywhere, including in empty containers. Versions
            before 1.0 may be withdrawn.
        </p>
    </div>
</section>`, values));

    r array_join([
        generate_head(`Download Nail`, `Every published release of Nail, and the one command that makes picking one unnecessary.`),
        html`<body hx-boost="true">`,
        generate_navbar(nav_html),
        section,
        generate_footer(),
        generate_menu_script(),
        html`</body>
</html>`
    ], ``);
}

f no_line(err:e):s {
    r ``;
}
