// The stylesheet for the whole page, one CSS block per area of the site.
// Dark theme in the style of the current generation of language sites
// (Astro, Bun, Deno, Gleam): near-black blue base, one warm amber accent,
// borders made of white at low alpha, monospace as a design accent.

// CSS styles - broken into sections for clarity
f generate_css():s {
    base_styles:s = css`
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --primary: #ffb454;
        --primary-dark: #ffc57a;
        --accent-2: #5ccfe6;
        --text-primary: #e8ebf0;
        --text-secondary: #9aa3b2;
        --text-faint: #5c6773;
        --bg-primary: #161a23;
        --bg-secondary: #0f1117;
        --bg-deep: #0c0e14;
        --border: rgba(255,255,255,0.08);
        --border-strong: rgba(255,255,255,0.16);
        --success: #aad94c;
        --warning: #ffd173;
        --error: #ff6666;
        --font-mono: ui-monospace, 'SF Mono', 'Cascadia Code', 'Fira Code', Menlo, Consolas, 'Liberation Mono', monospace;
    }

    body {
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.6;
        color: var(--text-primary);
        background-color: var(--bg-secondary);
        background-image: radial-gradient(900px 420px at 50% -80px, rgba(255,180,84,0.09), transparent 70%);
        background-repeat: no-repeat;
    }

    /* Code never wraps, so a block of it is wider than a phone. Every one of
       them scrolls inside its own edges, because overflow that is not
       contained is overflow the whole page carries, which is what makes a
       narrow screen scroll sideways over the entire site. */
    pre {
        max-width: 100%;
        overflow-x: auto;
    }

    h1, h2, h3 {
        letter-spacing: -0.02em;
    }

    code {
        font-family: var(--font-mono);
    }

    p code, li code {
        background: rgba(255,255,255,0.07);
        border: 1px solid var(--border);
        border-radius: 0.3rem;
        padding: 0.1rem 0.4rem;
        font-size: 0.88em;
        color: var(--text-primary);
    }

    ::selection {
        background: rgba(255,180,84,0.3);
    }

    a:focus-visible, button:focus-visible, summary:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }

    ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.14);
        border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.22);
    }`;

    navbar_styles:s = css`
    .navbar {
        position: sticky;
        top: 0;
        width: 100%;
        background: rgba(15,17,23,0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        z-index: 100;
        padding: 1rem 0;
    }

    .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .nav-brand {
        font-family: var(--font-mono);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-primary);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .nav-links {
        display: flex;
        gap: 2.5rem;
    }

    .nav-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

    .nav-link:hover {
        color: var(--primary);
    }

    .nav-toggle {
        display: none;
        background: none;
        border: 1px solid var(--border-strong);
        border-radius: 0.5rem;
        padding: 0.4rem 0.55rem;
        color: var(--text-primary);
        cursor: pointer;
        line-height: 0;
    }

    .nav-toggle svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    /* Nine links do not fit beside the wordmark on a phone, so below this
       width they move into a panel the hamburger opens. */
    @media (max-width: 900px) {
        .nav-toggle {
            display: inline-block;
        }

        .nav-links {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            flex-direction: column;
            gap: 0;
            background: var(--bg-secondary);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 16px 32px rgba(0,0,0,0.5);
            padding: 0.5rem 2rem 1rem;
            max-height: calc(100vh - 4.5rem);
            overflow-y: auto;
        }

        .nav-links.open {
            display: flex;
        }

        .nav-link {
            padding: 0.85rem 0;
            border-bottom: 1px solid var(--border);
        }

        .nav-link:last-child {
            border-bottom: none;
        }
    }`;

    hero_styles:s = css`
    .hero {
        max-width: 1200px;
        margin: 0 auto;
        padding: 6rem 2rem 4rem;
        text-align: center;
    }

    .hero-title {
        font-size: 4.5rem;
        font-weight: 800;
        margin-bottom: 1rem;
        background: linear-gradient(90deg, #ffb454 0%, #f28779 100%);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-tagline {
        font-size: 1.5rem;
        color: var(--text-primary);
        margin-bottom: 2rem;
    }

    .hero-description {
        font-size: 1.1rem;
        color: var(--text-secondary);
        max-width: 800px;
        margin: 0 auto 2rem;
        line-height: 1.8;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }`;

    button_styles:s = css`
    .btn {
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-block;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .btn-primary {
        background: var(--primary);
        color: #0f1117;
    }

    .btn-primary:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(255,180,84,0.25);
    }

    .btn-secondary {
        background: transparent;
        color: var(--text-primary);
        border-color: var(--border-strong);
    }

    .btn-secondary:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.3);
        transform: translateY(-2px);
    }

    .run-btn {
        position: absolute;
        bottom: 1rem;
        right: 1rem;
        background: var(--success);
        color: #0f1117;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        cursor: pointer;
        font-weight: 700;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        transition: all 0.2s;
    }

    .run-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(170,217,76,0.3);
    }

    .run-output {
        background: var(--bg-deep);
        border: 1px solid var(--border);
        color: var(--success);
        padding: 1rem;
        border-radius: 0.5rem;
        margin-top: 1rem;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        overflow-x: auto;
    }`;

    section_styles:s = css`
    section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .section-header h2 {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 1rem;
    }

    .section-header p {
        font-size: 1.2rem;
        color: var(--text-secondary);
    }`;

    feature_styles:s = css`
    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-top: 3rem;
    }

    .feature-card {
        background: var(--bg-primary);
        padding: 2rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border);
        transition: border-color 0.2s, transform 0.2s;
    }

    .feature-card:hover {
        transform: translateY(-3px);
        border-color: var(--border-strong);
    }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .feature-card h3 {
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .feature-card p {
        color: var(--text-secondary);
        line-height: 1.6;
    }`;

    code_styles:s = css`
    .code-example {
        background: var(--bg-primary);
        border: 1px solid var(--border);
        color: var(--text-primary);
        padding: 2rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 2rem 0;
        position: relative;
        /* A grid or flex child refuses to shrink below its content unless it
           is told it may, and a block of code is wider than a phone. Without
           this the block pushes its whole column wide and the page scrolls
           sideways rather than the code scrolling inside its own edges. */
        min-width: 0;
    }

    .rust-details {
        min-width: 0;
    }

    .code-example pre {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .code-label {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background: rgba(255,255,255,0.06);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        padding: 0.2rem 0.7rem;
        border-radius: 0.375rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.02em;
    }

    /* Token colors emitted by code_highlight_html (Nail's own lexer).
       Ayu Mirage adjacent, keywords in the brand amber family so the
       samples and the site read as one thing. */
    .tok-kw { color: #ff8f40; }
    .tok-cb { color: #f28779; font-weight: 600; }
    .tok-fn { color: #5ccfe6; }
    .tok-ty { color: #d2a6ff; }
    .tok-str { color: #aad94c; }
    /* A tagged string keeps the plain string colour for its tag, backticks and
       untokenized text; the language shows only in the pieces below. */
    /* Pieces of the language inside a tagged string: an element name in html,
       a selector in css, a keyword in js - one set of colours for all of them */
    .tok-md-punct { color: #6c7686; }
    .tok-md-el { color: #f28779; }
    .tok-md-attr { color: #73d0ff; }
    .tok-md-fn { color: #5ccfe6; }
    .tok-md-kw { color: #ff8f40; }
    .tok-md-op { color: #b3b9c5; }
    .tok-md-val { color: #ffd9a6; }
    .tok-md-num { color: #ffd173; }
    .tok-md-com { color: #5c6773; font-style: italic; }
    .tok-num { color: #ffd173; }
    .tok-com { color: #5c6773; font-style: italic; }
    .tok-op { color: #b3b9c5; }
    .tok-err { color: #ff6666; text-decoration: underline wavy; }

    .rust-details summary {
        cursor: pointer;
        display: inline-block;
        margin-top: 1rem;
        padding: 0.6rem 1.25rem;
        background: linear-gradient(135deg, #b7410e 0%, #8f3009 100%);
        color: white;
        font-weight: 600;
        border-radius: 0.5rem;
        border: 1px solid transparent;
        transition: all 0.2s;
        user-select: none;
        list-style: none;
    }

    .rust-details summary::-webkit-details-marker {
        display: none;
    }

    .rust-details summary::before {
        content: '▸ ';
    }

    .rust-details[open] summary::before {
        content: '▾ ';
    }

    .rust-details summary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(183, 65, 14, 0.35);
    }

    .rust-details .code-example {
        margin-top: 0.5rem;
        max-height: 420px;
        overflow-y: auto;
    }`;

    stdlib_styles:s = css`
    .stdlib-intro {
        max-width: 800px;
        margin: 0 auto 2.5rem;
        text-align: center;
        color: var(--text-secondary);
        font-size: 1.05rem;
        line-height: 1.8;
    }

    .stdlib-controls {
        text-align: center;
        margin-bottom: 2rem;
    }

    .stdlib-toggle {
        cursor: pointer;
        font-size: 1rem;
        font-family: inherit;
    }

    .stdlib-module {
        background: var(--bg-primary);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        margin-bottom: 1rem;
        padding: 1rem 1.5rem;
    }

    .stdlib-module summary {
        cursor: pointer;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-primary);
        list-style: none;
        user-select: none;
    }

    .stdlib-module summary::-webkit-details-marker {
        display: none;
    }

    .stdlib-module summary::before {
        content: '▸ ';
        color: var(--primary);
    }

    .stdlib-module[open] summary::before {
        content: '▾ ';
    }

    .stdlib-count {
        color: var(--text-secondary);
        font-size: 0.95rem;
        font-weight: 500;
    }

    .stdlib-module-name {
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .stdlib-fn {
        border-top: 1px solid var(--border);
        padding: 0.85rem 0;
    }

    .stdlib-sig {
        font-family: var(--font-mono);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--primary-dark);
        word-break: break-word;
    }

    .stdlib-desc {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-top: 0.25rem;
    }`;

    author_styles:s = css`
    .author-card {
        max-width: 900px;
        margin: 0 auto;
        background: var(--bg-primary);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 2.5rem;
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--text-secondary);
    }

    .author-photo {
        float: right;
        width: 11rem;
        height: 11rem;
        border-radius: 50%;
        object-fit: cover;
        margin: 0 0 1.5rem 2rem;
        shape-outside: circle(50%);
        background: var(--bg-deep);
    }

    .author-name {
        display: block;
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.35;
        color: var(--primary);
        margin-bottom: 0.5rem;
    }

    .author-card p + p {
        margin-top: 1rem;
    }

    .author-card a {
        color: var(--primary);
        text-decoration: underline;
    }

    @media (max-width: 600px) {
        .author-photo {
            float: none;
            display: block;
            margin: 0 auto 1.5rem;
        }

        /* Two rems of padding either side is a third of a phone screen. */
        .code-example {
            padding: 1rem;
        }

        .code-example pre {
            font-size: 0.8rem;
        }
    }`;

    ide_styles:s = css`
    .ide-shot {
        background: var(--bg-deep);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        margin: 0.75rem 0 0.5rem;
        overflow-x: auto;
        border: 1px solid var(--border);
    }

    .ide-shot pre {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        line-height: 1.25;
        color: #cdd6f4;
        white-space: pre;
    }

    .ide-caption {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    .lang-tags {
        margin: 0 0 2rem;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        overflow: hidden;
        background: var(--bg-primary);
    }

    .lang-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        align-items: center;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--border);
    }

    .lang-row:last-child {
        border-bottom: none;
    }

    .lang-name {
        flex: 0 0 8.5rem;
        color: var(--text-secondary);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .lang-list {
        flex: 1 1 16rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .lang-list code {
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        background: var(--bg-deep);
        border: 1px solid var(--border);
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }`;

    philosophy_styles:s = css`
    .philosophy-content {
        max-width: 800px;
        margin: 0 auto;
        font-size: 1.1rem;
        line-height: 1.8;
        color: var(--text-secondary);
    }

    .philosophy-quote {
        background: var(--bg-primary);
        border: 1px solid var(--border);
        border-left: 4px solid var(--primary);
        border-radius: 0 0.5rem 0.5rem 0;
        padding: 1.5rem 2rem;
        margin: 2rem 0;
        font-style: italic;
        font-size: 1.2rem;
        color: var(--text-primary);
    }`;

    table_styles:s = css`
    .perf-card {
        background: var(--bg-primary);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.5rem 2rem;
        margin: 2rem 0;
    }

    .bench-wrap {
        overflow-x: auto;
        margin: 1.5rem 0;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
    }

    .bench-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--bg-primary);
    }

    .bench-table th, .bench-table td {
        padding: 0.75rem 1rem;
        text-align: left;
    }

    .bench-table th:not(:first-child), .bench-table td:not(:first-child) {
        text-align: right;
    }

    .bench-table th {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border-strong);
    }

    .bench-table td {
        border-bottom: 1px solid var(--border);
    }

    .bench-table tr:last-child td {
        border-bottom: none;
    }

    .bench-win {
        color: var(--success);
        font-weight: 700;
    }`;

    footer_styles:s = css`
    .site-footer {
        border-top: 1px solid var(--border);
        background: var(--bg-deep);
        padding: 3rem 2rem;
        margin-top: 4rem;
        color: var(--text-secondary);
    }

    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
    }

    .footer-note {
        font-size: 1.05rem;
        margin-bottom: 1rem;
    }

    .footer-links {
        display: flex;
        gap: 2rem;
        justify-content: center;
        margin-top: 1.5rem;
    }

    .footer-links a {
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s;
    }

    .footer-links a:hover {
        color: var(--primary);
    }`;

    sandbox_styles:s = css`
    .sandbox-points {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin: 0 auto 2.5rem;
        max-width: 800px;
    }

    .sandbox-point {
        border: 1px solid var(--border);
        border-radius: 2rem;
        padding: 0.4rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--text-secondary);
        background: var(--bg-primary);
    }

    .sandbox-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
    }

    .sandbox-grid .code-example {
        margin: 0;
    }

    .sandbox-verdict {
        border-left: 4px solid var(--error);
        margin: 1.5rem 0 2rem;
    }

    .sandbox-verdict pre {
        color: #ffa198;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .sandbox-note {
        max-width: 800px;
        margin: 0 auto 1.25rem;
        text-align: center;
        color: var(--text-secondary);
        line-height: 1.8;
    }

    .refusal-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
    }

    .refusal-pane {
        min-width: 0;
    }

    .refusal-pane .code-example {
        margin: 0 0 1rem;
    }

    @media (max-width: 1000px) {
        .refusal-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 900px) {
        .sandbox-grid {
            grid-template-columns: 1fr;
        }
    }`;

    r array_join([
        base_styles,
        navbar_styles,
        hero_styles,
        button_styles,
        section_styles,
        feature_styles,
        code_styles,
        ide_styles,
        stdlib_styles,
        author_styles,
        philosophy_styles,
        table_styles,
        footer_styles,
        sandbox_styles
    ], ``);
}
