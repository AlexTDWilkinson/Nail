nail latest
// This is not a standalone program: examples/website/main.nail imports it.
// Builds everything the request handler serves: the assembled page, the
// run-example outputs computed at startup, and the state hashmap that
// carries them into the handler.

// Assemble the complete HTML
website_html:s = array_join([
    generate_head(site_title, site_description),
    html`<body hx-boost="true">`,
    generate_navbar(nav_html),
    generate_hero(hero_snippet_html),
    generate_whole_language(whole_language_html, whole_language_rust_lines),
    generate_refusals(refused_error_html, refused_error_verdict, refused_field_html, refused_field_verdict, refused_nothing_html, refused_nothing_verdict),
    generate_features(),
    generate_examples(concurrent_example_html, parallel_example_html, error_example_html, concurrent_rust_html, parallel_rust_html, error_rust_html),
    generate_games_section(),
    generate_import_section(jailbreak_html, sandbox_demo_html, sandbox_verdict_html),
    generate_mcp(mcp_example_html),
    generate_stdlib_teaser(array_length(stdlib_function_list), array_length(stdlib_module_list), battery_rows),
    generate_get_started(),
    generate_ide(ide_shot_error, ide_shot_complete, ide_shot_docs, tagged_snippet_html),
    generate_performance(),
    generate_profiling(ide_shot_profiling),
    generate_versioning(),
    generate_author(author_avatar),
    generate_footer(),
    generate_playground_script(),
    generate_menu_script(),
    html`</body>
</html>`
], ``);

// Everything the request handler serves travels through the config hashmap:
// a Nail function can only see its parameters, so page content computed up
// here reaches handle_request that way rather than as a global.
state:h<s,s> = hashmap_new();
hashmap_set(state, `page_main`, website_html);
hashmap_set(state, `install_script`, install_script);
hashmap_set(state, `page_downloads`, generate_downloads_page(releases_tsv, nav_html_away));

// The standard library listing is its own page: it is massive, so the front
// page carries a teaser and this carries the whole thing.
stdlib_page_html:s = generate_stdlib_page(
    `Nail standard library - every function that ships with the compiler`,
    `The full Nail standard library, printed by the compiler that serves this page.`,
    stdlib_function_list,
    stdlib_module_list
);
hashmap_set(state, `page_stdlib`, stdlib_page_html);

// The browser games: one minimal embed page per demo, framed by the games
// section on the home page. The wasm they load is on the /wasm static mount.
hashmap_set(state, `page_platformer_embed`, generate_game_embed_page(
    `A platformer, written in Nail`,
    `/wasm/platformer/pkg/platformer_wasm.js`
));
hashmap_set(state, `page_viewer_embed`, generate_game_embed_page(
    `A 3D model viewer, written in Nail`,
    `/wasm/viewer/pkg/viewer_wasm.js`
));
hashmap_set(state, `page_monolith_embed`, generate_game_embed_page(
    `A field of meshes on the graphics card, written in Nail`,
    `/wasm/monolith/pkg/monolith_wasm.js`
));

// Routes for running examples. The outputs are built from values this server
// actually computed at startup by executing the same code the examples show.
run_note:s = `\\n\\n(Real output: computed by this server, itself a Nail program, by running the code above.)`;

concurrent_output:s = array_join([
    `{"output": "Language spec chars: `, string_from(string_length(spec_text)),
    `\\nREADME chars: `, string_from(string_length(readme_text)),
    `\\nWebsite source chars: `, string_from(string_length(website_text)),
    `\\nEvery read finished together in `, elapsed_label(concurrent_elapsed_us), run_note, `"}`
], ``);

hashmap_set(state, `example_concurrent`, concurrent_output);

parallel_output:s = array_join([
    `{"output": "12! = `, string_from(fact_12),
    `\\nSum of 1 to 1,000,000 = `, string_from(sum_to_million),
    `\\nPrimes below 10,000 = `, string_from(prime_count),
    `\\nAll three computed together in `, elapsed_label(parallel_elapsed_us),
    run_note, `"}`
], ``);

hashmap_set(state, `example_parallel`, parallel_output);

error_output:s = array_join([
    `{"output": "10 / 2 = `, string_from(div_ok),
    `\\nError occurred: Cannot divide by zero!\\nResult with error handling: `, string_from(div_fallback),
    `\\nBoth paths handled in `, elapsed_label(error_elapsed_us),
    run_note, `"}`
], ``);

hashmap_set(state, `example_error`, error_output);

// The machine-readable documentation routes, following the llms.txt
// convention. /llms.txt is the agent primer plus a pointer to the full
// dump. /llms-full.txt is everything a model needs in one fetch: the
// primer, the whole specification, and the signature and description of
// every standard library function, printed by the compiler serving them.
stdlib_reference_lines:a:s = map func in stdlib_function_list {
    y stdlib_reference_entry(func);
};
llms_pointer:s = `\n\n## The full reference\n\n- https://nail.alex-wilkinson.ca/llms-full.txt: this primer, then the complete language specification, then every standard library function with its signature and description\n`;
hashmap_set(state, `llms_txt`, string_concat([primer_text, llms_pointer]));
hashmap_set(state, `llms_full`, array_join([
    primer_text,
    `\n\n`,
    spec_text,
    `\n\n# The Nail standard library\n\nEvery function that ships with the compiler, printed by the compiler serving this page.\n\n`,
    array_join(stdlib_reference_lines, `\n`),
    `\n`
], ``));
