// Sandboxed with import: the compiler proves this file only computes.
// A file like this could be downloaded from the internet and inserted unread,
// nothing in it can touch the machine it runs on.
//
// Sort keys, grouping, and row shaping for the standard library listing and
// the batteries table.

f stdlib_order_key(func:STDLIB_Function):s {
    r string_concat([func.module, ` `, func.name]);
}

f stdlib_function_module(function:STDLIB_Function):s {
    r function.module;
}

f no_functions(err:e):a:STDLIB_Function {
    r [];
}

f battery_row(expression:s, answer:s):h<s,s> {
    row:h<s,s> = hashmap_new();
    hashmap_set(row, `expression`, expression);
    hashmap_set(row, `answer`, answer);
    r row;
}
