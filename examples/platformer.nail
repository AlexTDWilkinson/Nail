// One way in to all of it, so everything else asks for a level by number.
f level_platforms(level:i):a:Platform {
    if {
        level == 1 -> { r level_one_platforms(); },
        level == 2 -> { r level_two_platforms(); },
        level == 3 -> { r level_three_platforms(); },
        level == 4 -> { r level_four_platforms(); },
        else -> { r level_five_platforms(); }
    }
}

f level_coins(level:i):a:Coin {
    if {
        level == 1 -> { r level_one_coins(); },
        level == 2 -> { r level_two_coins(); },
        level == 3 -> { r level_three_coins(); },
        level == 4 -> { r level_four_coins(); },
        else -> { r level_five_coins(); }
    }
}

f level_foes(level:i):a:Enemy {
    if {
        level == 1 -> { r level_one_foes(); },
        level == 2 -> { r level_two_foes(); },
        level == 3 -> { r level_three_foes(); },
        level == 4 -> { r level_four_foes(); },
        else -> { r level_five_foes(); }
    }
}

f level_spikes(level:i):a:Spike {
    if {
        level == 1 -> { r level_one_spikes(); },
        level == 2 -> { r level_two_spikes(); },
        level == 3 -> { r level_three_spikes(); },
        level == 4 -> { r level_four_spikes(); },
        else -> { r level_five_spikes(); }
    }
}

// Every coin in the game, counted rather than written down, so the closing
// line can never disagree with the levels.
f total_coins():i {
    r array_length(level_coins(1)) + array_length(level_coins(2)) + array_length(level_coins(3)) + array_length(level_coins(4)) + array_length(level_coins(5));
}

f taken_count(coins:a:Coin):i {
    taken:a:Coin = filter coin in coins {
        y coin.taken;
    };
    r array_length(taken);
}

// The run so far. A level that has been cleared is already in the bank, so
// adding its coins again on a card would count them twice.
f coins_so_far(state:Platformer):i {
    if {
        state.mode == Mode::Cleared || state.mode == Mode::Finished -> { r state.banked; },
        else -> { r state.banked + taken_count(state.coins); }
    }
}

// A level from its beginning. Coins and enemies come back fresh, the score
// from earlier levels and the tally of deaths carry on. Every held flag starts
// true, so the press that asked for this level is not read again inside it.
f start_level(level:i, banked:i, deaths:i):Platformer {
    r Platformer {
        mode = Mode::Running, level = level, banked = banked, deaths = deaths, intro_ms = 1700.0,
        player_x = 60.0, player_y = 524.0, vel_x = 0.0, vel_y = 0.0, coyote_ms = 0.0, camera_x = 0.0,
        coins = level_coins(level), foes = level_foes(level), jump_held = true, reset_held = true,
        tap_held = true, step_phase = 0.0, pressing_left = false, pressing_right = false,
        pressing_jump = false, done = false
    };
}

// After dying. The level starts over and the enemies come back, but the coins
// already taken stay taken, so a bad fall costs the run and not the collection.
f respawn(state:Platformer):Platformer {
    r Platformer {
        mode = Mode::Running, level = state.level, banked = state.banked, deaths = state.deaths + 1,
        intro_ms = 0.0, player_x = 60.0, player_y = 524.0, vel_x = 0.0, vel_y = 0.0, coyote_ms = 0.0,
        camera_x = 0.0, coins = state.coins, foes = level_foes(state.level), jump_held = true,
        reset_held = true, tap_held = true, step_phase = 0.0, pressing_left = false,
        pressing_right = false, pressing_jump = false, done = false
    };
}

// The screens between levels change which card is showing and nothing else,
// so they all come through here rather than writing the state out again.
f with_mode(state:Platformer, mode:Mode, tap_held:b, done:b):Platformer {
    r Platformer {
        mode = mode, level = state.level, banked = state.banked, deaths = state.deaths,
        intro_ms = state.intro_ms, player_x = state.player_x, player_y = state.player_y,
        vel_x = state.vel_x, vel_y = state.vel_y, coyote_ms = state.coyote_ms,
        camera_x = state.camera_x, coins = state.coins, foes = state.foes,
        jump_held = state.jump_held, reset_held = state.reset_held, tap_held = tap_held,
        step_phase = state.step_phase, pressing_left = false, pressing_right = false,
        pressing_jump = false, done = done
    };
}

f new_game():Platformer {
    r with_mode(start_level(1, 0, 0), Mode::Title, false, false);
}

// The player is a 28 by 36 rectangle. True when it overlaps a platform.
f hits_platform(pos_x:f, pos_y:f, plat:Platform):b {
    r pos_x < (plat.plat_x + plat.plat_w) && (pos_x + 28.0) > plat.plat_x && pos_y < (plat.plat_y + plat.plat_h) && (pos_y + 36.0) > plat.plat_y;
}

// Horizontal resolution for one platform: a hit pushes the player back out
// on the side it came from, a miss changes nothing.
f push_out_x(pos_x:f, pos_y:f, old_x:f, plat:Platform):f {
    if {
        hits_platform(pos_x, pos_y, plat) -> {
            if {
                old_x < plat.plat_x -> { r plat.plat_x - 28.0; },
                else -> { r plat.plat_x + plat.plat_w; }
            }
        },
        else -> { r pos_x; }
    }
}

f collide_x(try_x:f, pos_y:f, old_x:f, platforms:a:Platform):f {
    result:f = try_x;
    for plat in platforms {
        result = push_out_x(result, pos_y, old_x, plat);
    }
    r result;
}

// Vertical resolution for one platform. Feet that were above the top last
// frame land on it, anything else is a head bump against the underside.
f push_out_y(landing:Landing, pos_x:f, old_y:f, plat:Platform):Landing {
    if {
        hits_platform(pos_x, landing.land_y, plat) -> {
            if {
                (old_y + 36.0) <= (plat.plat_y + 0.01) -> {
                    r Landing { land_y = plat.plat_y - 36.0, land_vel = 0.0, grounded = true };
                },
                else -> {
                    r Landing { land_y = plat.plat_y + plat.plat_h, land_vel = 0.0, grounded = false };
                }
            }
        },
        else -> { r landing; }
    }
}

f collide_y(try_y:f, pos_x:f, old_y:f, fall_vel:f, platforms:a:Platform):Landing {
    result:Landing = Landing { land_y = try_y, land_vel = fall_vel, grounded = false };
    for plat in platforms {
        result = push_out_y(result, pos_x, old_y, plat);
    }
    r result;
}

// Held keys accelerate toward a top speed of 0.38 pixels per millisecond,
// letting go bleeds speed away, so starts and stops both have weight.
f step_vel_x(vel:f, left_held:b, right_held:b, delta:f):f {
    if {
        left_held && (right_held == false) -> { r math_max(vel - (0.0028 * delta), -0.38); },
        right_held && (left_held == false) -> { r math_min(vel + (0.0028 * delta), 0.38); },
        vel > 0.0 -> { r math_max(vel - (0.0035 * delta), 0.0); },
        else -> { r math_min(vel + (0.0035 * delta), 0.0); }
    }
}

// A coin within arm's reach of the player flips to taken and stays taken.
f collect_coin(coin:Coin, pos_x:f, pos_y:f):Coin {
    touching:b = coin.coin_x > (pos_x - 10.0) && coin.coin_x < (pos_x + 38.0) && coin.coin_y > (pos_y - 10.0) && coin.coin_y < (pos_y + 46.0);
    if {
        coin.taken || touching -> { r Coin { coin_x = coin.coin_x, coin_y = coin.coin_y, taken = true }; },
        else -> { r coin; }
    }
}

// Walkers are a little wider than flyers, and both are square.
f foe_size(menace:Menace):f {
    if {
        menace == Menace::Walker -> { r 26.0; },
        else -> { r 24.0; }
    }
}

// One enemy's step. Both kinds pace between the same two ends and turn around
// at either, a flyer adding a bob it carries in its own phase so two of them
// side by side are not in lockstep.
f move_enemy(foe:Enemy, delta:f):Enemy {
    size:f = foe_size(foe.menace);
    raw_x:f = foe.foe_x + (foe.foe_dir * foe.foe_pace * delta);
    turned:b = raw_x < foe.foe_from || raw_x > (foe.foe_to - size);
    dir:f = if {
        turned -> { r 0.0 - foe.foe_dir; },
        else -> { r foe.foe_dir; }
    };
    pos_x:f = math_clamp(raw_x, foe.foe_from, foe.foe_to - size);
    raw_bob:f = foe.foe_bob + (0.004 * delta);
    bob:f = if {
        raw_bob > 6.2831853 -> { r raw_bob - 6.2831853; },
        else -> { r raw_bob; }
    };
    pos_y:f = if {
        foe.menace == Menace::Flyer -> { r foe.foe_home + (math_sin(bob) * 34.0); },
        else -> { r foe.foe_y; }
    };
    r Enemy {
        foe_x = pos_x, foe_y = pos_y, foe_from = foe.foe_from, foe_to = foe.foe_to, foe_dir = dir,
        foe_pace = foe.foe_pace, foe_home = foe.foe_home, foe_bob = bob, menace = foe.menace,
        foe_alive = foe.foe_alive
    };
}

// A living enemy overlapping the player. Dead ones are simply scenery that is
// no longer drawn.
f enemy_hit(foe:Enemy, pos_x:f, pos_y:f):b {
    size:f = foe_size(foe.menace);
    r foe.foe_alive && pos_x < (foe.foe_x + size) && (pos_x + 28.0) > foe.foe_x && pos_y < (foe.foe_y + size) && (pos_y + 36.0) > foe.foe_y;
}

// Landing on one counts as a stomp, walking into one does not. The test is
// where the feet were before this step rather than where they are now, so a
// fast fall cannot pass through the top of a head and come out as a hit.
f stomped(foe:Enemy, pos_x:f, pos_y:f, old_y:f, fall_vel:f):b {
    r enemy_hit(foe, pos_x, pos_y) && fall_vel > 0.0 && (old_y + 36.0) <= (foe.foe_y + 14.0);
}

f squash_enemy(foe:Enemy, pos_x:f, pos_y:f, old_y:f, fall_vel:f):Enemy {
    if {
        stomped(foe, pos_x, pos_y, old_y, fall_vel) -> {
            r Enemy {
                foe_x = foe.foe_x, foe_y = foe.foe_y, foe_from = foe.foe_from, foe_to = foe.foe_to,
                foe_dir = foe.foe_dir, foe_pace = foe.foe_pace, foe_home = foe.foe_home,
                foe_bob = foe.foe_bob, menace = foe.menace, foe_alive = false
            };
        },
        else -> { r foe; }
    }
}

// Spikes are eighty wide and their teeth stand seventeen pixels proud of the
// surface they sit on, so only feet low enough to be among them are caught.
f spike_hit(spike:Spike, pos_x:f, pos_y:f):b {
    r pos_x < (spike.spike_x + 80.0) && (pos_x + 28.0) > spike.spike_x && (pos_y + 36.0) > (spike.spike_y - 13.0) && pos_y < spike.spike_y;
}

// Four notes climbing a major chord. The whole tune is queued in one go and
// the sound system keeps its time, so no frame waits on it. Each note says
// which beat it lands on rather than carrying a hand-added offset, and the
// silence between notes is simply the gap between their beats.
f play_win_tune():v {
    beat:f = 0.13;
    danger(audio_tone_after(523.0, 0.14, 0.14, beat * 0.0));
    danger(audio_tone_after(659.0, 0.14, 0.14, beat * 1.0));
    danger(audio_tone_after(784.0, 0.14, 0.14, beat * 2.0));
    danger(audio_tone_after(1047.0, 0.30, 0.16, beat * 3.0));
}

// The same shape upside down and slower, which is what sad sounds like.
f play_fall_tune():v {
    beat:f = 0.15;
    danger(audio_tone_after(392.0, 0.16, 0.13, beat * 0.0));
    danger(audio_tone_after(311.0, 0.16, 0.13, beat * 1.0));
    danger(audio_tone_after(233.0, 0.34, 0.14, beat * 2.0));
}

// The last level earns a longer version of the win tune, up an octave and out
// through the fifth, so finishing the game does not sound like finishing a
// level.
f play_finish_tune():v {
    beat:f = 0.15;
    danger(audio_tone_after(523.0, 0.15, 0.14, beat * 0.0));
    danger(audio_tone_after(659.0, 0.15, 0.14, beat * 1.0));
    danger(audio_tone_after(784.0, 0.15, 0.14, beat * 2.0));
    danger(audio_tone_after(1047.0, 0.15, 0.15, beat * 3.0));
    danger(audio_tone_after(1319.0, 0.15, 0.15, beat * 4.0));
    danger(audio_tone_after(1568.0, 0.45, 0.17, beat * 5.0));
}

// The pads, in the coordinates both the drawing and the touching use. A finger
// or a mouse inside one counts as that control. The three at the bottom play
// the game, the small one at the top right starts the level over, and the last
// is the whole window, which is what leaves a card between levels.
f left_pad():a:f { r [20.0, 480.0, 74.0, 74.0]; }
f right_pad():a:f { r [104.0, 480.0, 74.0, 74.0]; }
f jump_pad():a:f { r [648.0, 470.0, 94.0, 94.0]; }
f reset_pad():a:f { r [722.0, 14.0, 62.0, 62.0]; }
f whole_window():a:f { r [0.0, 0.0, 800.0, 600.0]; }

f point_in_pad(point_x:f, point_y:f, pad:a:f):b {
    pad_x:f = danger(array_get(pad, 0));
    pad_y:f = danger(array_get(pad, 1));
    pad_w:f = danger(array_get(pad, 2));
    pad_h:f = danger(array_get(pad, 3));
    r point_x >= pad_x && point_x <= (pad_x + pad_w) && point_y >= pad_y && point_y <= (pad_y + pad_h);
}

// Every finger is checked, not just the first one, so holding a direction
// and jumping at the same time works. Reading only the first finger is
// what made the game unplayable by touch.
f pad_pressed(input:GAME_Input, pad:a:f):b {
    fingers:i = array_length(input.touches) / 2;
    touched:b = any index in array_range(0, fingers) {
        y point_in_pad(danger(array_get(input.touches, index * 2)), danger(array_get(input.touches, (index * 2) + 1)), pad);
    };
    r touched || (input.mouse_down && point_in_pad(input.mouse_x, input.mouse_y, pad));
}

// Yes, go on, carry on: the one answer every card between levels is waiting
// for, from whichever key is nearest.
f confirm_key(input:GAME_Input):b {
    r array_contains(input.keys_pressed, `Space`) || array_contains(input.keys_pressed, `Enter`) || array_contains(input.keys_pressed, `Up`) || array_contains(input.keys_pressed, `w`);
}

// One physics step: read the input, move and collide on each axis in turn,
// then settle the enemies, the pits, the spikes, the coins, the flag and the
// camera. reset_down is whether the restart pad is under a finger, which the
// caller has already looked at, and which is remembered so holding it down
// restarts once.
f step_world(state:Platformer, input:GAME_Input, reset_down:b):Platformer {
    // A stalled frame is capped so the player never tunnels through a floor.
    delta:f = math_min(input.delta_ms, 32.0);
    platforms:a:Platform = level_platforms(state.level);

    // Keys and pads say the same things, so a phone and a keyboard play the
    // same game. A held jump pad only jumps on the frame it went down.
    jump_pad_now:b = pad_pressed(input, jump_pad());
    left_held:b = array_contains(input.keys_down, `Left`) || array_contains(input.keys_down, `a`) || pad_pressed(input, left_pad());
    right_held:b = array_contains(input.keys_down, `Right`) || array_contains(input.keys_down, `d`) || pad_pressed(input, right_pad());
    jump_pressed:b = array_contains(input.keys_pressed, `Space`) || array_contains(input.keys_pressed, `Up`) || array_contains(input.keys_pressed, `w`) || (jump_pad_now && (state.jump_held == false));

    // Sideways first, clamped to the ends of the level.
    vel_x:f = step_vel_x(state.vel_x, left_held, right_held, delta);
    slid_x:f = collide_x(state.player_x + (vel_x * delta), state.player_y, state.player_x, platforms);
    pos_x:f = math_clamp(slid_x, 0.0, level_span(state.level) - 28.0);

    // A jump is allowed while feet are on ground or for the 90 millisecond
    // coyote window just after walking off an edge. Jumping spends the
    // window at once, which is exactly the no double jump rule.
    may_jump:b = state.coyote_ms < 90.0;
    jumped:b = jump_pressed && may_jump;
    launch_vel:f = if {
        jumped -> { r -0.78; },
        else -> { r state.vel_y; }
    };
    fall_vel:f = math_min(launch_vel + (0.0022 * delta), 0.95);
    landing:Landing = collide_y(state.player_y + (fall_vel * delta), pos_x, state.player_y, fall_vel, platforms);

    // The enemies move before anything is asked about them, so what the player
    // is judged against is where they are now and not where they were.
    moved_foes:a:Enemy = map foe in state.foes {
        y move_enemy(foe, delta);
    };
    settled_foes:a:Enemy = map foe in moved_foes {
        y squash_enemy(foe, pos_x, landing.land_y, state.player_y, fall_vel);
    };
    stomps:a:Enemy = filter foe in moved_foes {
        y stomped(foe, pos_x, landing.land_y, state.player_y, fall_vel);
    };
    bounced:b = array_length(stomps) > 0;

    // A stomp kills the enemy first and hurts second, so landing on one of two
    // that overlap is a stomp and not a death. Anything still alive and still
    // touching after that is what kills the run.
    touching:a:Enemy = filter foe in settled_foes {
        y enemy_hit(foe, pos_x, landing.land_y);
    };
    spiked:a:Spike = filter spike in level_spikes(state.level) {
        y spike_hit(spike, pos_x, landing.land_y);
    };
    if {
        array_length(touching) > 0 || array_length(spiked) > 0 || landing.land_y > 700.0 -> {
            play_fall_tune();
            r respawn(state);
        },
        else -> {}
    }

    // A stomp throws the player back up, which is both the reward and the way
    // out of a row of walkers.
    vel_y:f = if {
        bounced -> { r -0.62; },
        else -> { r landing.land_vel; }
    };
    coyote_ms:f = if {
        bounced -> { r 90.0; },
        landing.grounded -> { r 0.0; },
        jumped -> { r 90.0; },
        else -> { r state.coyote_ms + delta; }
    };

    coins:a:Coin = map coin in state.coins {
        y collect_coin(coin, pos_x, landing.land_y);
    };

    // Sounds mark moments, not states: a coin the instant it is taken, a
    // jump as it leaves the ground, a thud on landing from a real fall.
    // audio_tone_start comes straight back, so no frame waits for a sound.
    if {
        taken_count(coins) > taken_count(state.coins) -> { danger(audio_tone_start(880.0, 0.06, 0.15)); },
        else -> {}
    }
    if {
        bounced -> { danger(audio_tone_start(330.0, 0.07, 0.16)); },
        else -> {}
    }
    if {
        jumped -> { danger(audio_tone_start(523.0, 0.07, 0.12)); },
        else -> {}
    }
    if {
        landing.grounded && state.vel_y > 0.35 -> { danger(audio_tone_start(196.0, 0.05, 0.12)); },
        else -> {}
    }

    // Footsteps come from ground covered rather than from a clock, so they
    // keep pace with the run and stop dead when the player does. One step per
    // full swing of the legs, which at a run is about four a second. Half
    // that distance is what the legs actually do and it sounds like a drum
    // roll, so only one foot of the pair is heard.
    // Ground covered means the distance actually travelled, not the speed
    // asked for, so running into a wall makes no footsteps at all. Creeping
    // slower than a third of a pixel a frame does not count as walking, but
    // it does not throw the stride away either: turning around passes
    // through standing still, and a stride reset there would swallow the
    // step that should land as the player sets off the other way. Only
    // leaving the ground breaks the stride.
    ground_covered:f = math_abs(pos_x - state.player_x);
    moved:f = if {
        ground_covered > 0.35 -> { r ground_covered; },
        else -> { r 0.0; }
    };
    walked:f = if {
        landing.grounded -> { r state.step_phase + moved; },
        else -> { r 0.0; }
    };
    stepped:b = walked > 62.0;
    step_phase:f = if {
        stepped -> { r walked - 62.0; },
        else -> { r walked; }
    };
    // Louder than the numbers suggest it needs to be: the sound decays across
    // its whole length, so the volume asked for is the peak at the very start
    // and the ear hears roughly half of it.
    if {
        stepped -> { danger(audio_tone_start(210.0, 0.05, 0.24)); },
        else -> {}
    }

    // The flag. The last level ends the game, every other one puts up a card
    // and banks what this level was worth.
    reached:b = pos_x > (flag_x(state.level) - 30.0);
    finished:b = reached && (state.level >= level_count());
    mode:Mode = if {
        finished -> { r Mode::Finished; },
        reached -> { r Mode::Cleared; },
        else -> { r Mode::Running; }
    };
    if {
        finished -> { play_finish_tune(); },
        reached -> { play_win_tune(); },
        else -> {}
    }
    banked:i = if {
        reached -> { r state.banked + taken_count(coins); },
        else -> { r state.banked; }
    };

    // What the player is asking for this frame, key or finger alike, so the
    // pads can show it.
    pressing_jump:b = jump_pad_now || array_contains(input.keys_down, `Space`) || array_contains(input.keys_down, `Up`) || array_contains(input.keys_down, `w`);

    // The camera trails the player with lead room ahead and never shows
    // past either end of the level.
    camera_goal:f = math_clamp(pos_x - 300.0, 0.0, level_span(state.level) - 800.0);
    camera_x:f = state.camera_x + ((camera_goal - state.camera_x) * math_min(1.0, 0.012 * delta));

    r Platformer {
        mode = mode, level = state.level, banked = banked, deaths = state.deaths,
        intro_ms = math_max(state.intro_ms - delta, 0.0),
        player_x = pos_x, player_y = landing.land_y, vel_x = vel_x, vel_y = vel_y,
        coyote_ms = coyote_ms, camera_x = camera_x, coins = coins, foes = settled_foes,
        jump_held = jump_pad_now, reset_held = reset_down, tap_held = pad_pressed(input, whole_window()),
        step_phase = step_phase, pressing_left = left_held, pressing_right = right_held,
        pressing_jump = pressing_jump, done = false
    };
}

// The title card waits for anything at all, and the whole window is the
// button, which is the only thing a first-time finger reliably finds.
f title_update(state:Platformer, input:GAME_Input):Platformer {
    tap:b = pad_pressed(input, whole_window());
    go:b = confirm_key(input) || (tap && (state.tap_held == false));
    if {
        go -> { r start_level(1, 0, 0); },
        else -> { r with_mode(state, Mode::Title, tap, false); }
    }
}

f cleared_update(state:Platformer, input:GAME_Input):Platformer {
    tap:b = pad_pressed(input, whole_window());
    go:b = confirm_key(input) || (tap && (state.tap_held == false));
    if {
        go -> { r start_level(state.level + 1, state.banked, state.deaths); },
        else -> { r with_mode(state, Mode::Cleared, tap, false); }
    }
}

f finished_update(state:Platformer, input:GAME_Input):Platformer {
    tap:b = pad_pressed(input, whole_window());
    go:b = confirm_key(input) || (tap && (state.tap_held == false));
    if {
        go -> { r start_level(1, 0, 0); },
        else -> { r with_mode(state, Mode::Finished, tap, false); }
    }
}

// R and the pad at the top right are the same thing, and both start the level
// over rather than the game, which is what a stuck run actually needs. A
// restart is not a death, so the tally is left alone.
f running_update(state:Platformer, input:GAME_Input):Platformer {
    reset_down:b = pad_pressed(input, reset_pad());
    restarting:b = array_contains(input.keys_pressed, `r`) || (reset_down && (state.reset_held == false));
    if {
        restarting -> { r start_level(state.level, state.banked, state.deaths); },
        else -> { r step_world(state, input, reset_down); }
    }
}

f update(state:Platformer, input:GAME_Input):Platformer {
    if {
        array_contains(input.keys_pressed, `Esc`) -> { r with_mode(state, state.mode, state.tap_held, true); },
        state.mode == Mode::Title -> { r title_update(state, input); },
        state.mode == Mode::Cleared -> { r cleared_update(state, input); },
        state.mode == Mode::Finished -> { r finished_update(state, input); },
        else -> { r running_update(state, input); }
    }
}

// The night deepens as the levels go on, which is the cheapest way to make
// five runs through the same city feel like five different nights.
f sky_tint(level:i):s {
    if {
        level == 1 -> { r `#101018`; },
        level == 2 -> { r `#0e1420`; },
        level == 3 -> { r `#161022`; },
        level == 4 -> { r `#1a1020`; },
        else -> { r `#1e1018`; }
    }
}

f moon_tint(level:i):s {
    if {
        level == 1 -> { r `#d9b45f`; },
        level == 2 -> { r `#c9d2e8`; },
        level == 3 -> { r `#d9a0c0`; },
        level == 4 -> { r `#e0a95f`; },
        else -> { r `#d97a6a`; }
    }
}

// A lofi mountain city at night, five depths deep: a still sky with a
// crescent and stars, triangle mountains barely creeping at eight
// percent of camera speed, a hillside of far buildings at fifteen, the
// plum skyline with lit windows at forty, and near towers at seventy.
// Every layer outruns the one behind it, which is what makes it deep.
f backdrop_shapes(camera_x:f, level:i):a:GAME_Shape {
    mountain_slide:f = camera_x * 0.08;
    far_slide:f = camera_x * 0.15;
    slide:f = camera_x * 0.4;
    near_slide:f = camera_x * 0.7;
    sky:a:GAME_Shape = [
        game_circle(650.0, 94.0, 40.0, `#1c1826`),
        game_circle(650.0, 94.0, 30.0, moon_tint(level)),
        game_circle(662.0, 85.0, 24.0, sky_tint(level)),
        game_rect(90.0, 60.0, 2.0, 2.0, `#4a4458`),
        game_rect(210.0, 130.0, 2.0, 2.0, `#4a4458`),
        game_rect(330.0, 45.0, 3.0, 3.0, `#5c5470`),
        game_rect(470.0, 110.0, 2.0, 2.0, `#4a4458`),
        game_rect(555.0, 38.0, 2.0, 2.0, `#4a4458`),
        game_rect(720.0, 160.0, 2.0, 2.0, `#4a4458`),
        game_rect(150.0, 210.0, 2.0, 2.0, `#3f3a52`),
        game_rect(620.0, 230.0, 3.0, 3.0, `#5c5470`)
    ];
    mountains:a:GAME_Shape = [
        game_triangle(-80.0 - mountain_slide, 600.0, 180.0 - mountain_slide, 250.0, 440.0 - mountain_slide, 600.0, `#151020`),
        game_triangle(120.0 - mountain_slide, 600.0, 205.0 - mountain_slide, 290.0, 260.0 - mountain_slide, 336.0, `#1f1a2e`),
        game_triangle(300.0 - mountain_slide, 600.0, 540.0 - mountain_slide, 210.0, 780.0 - mountain_slide, 600.0, `#181324`),
        game_triangle(500.0 - mountain_slide, 600.0, 570.0 - mountain_slide, 258.0, 615.0 - mountain_slide, 305.0, `#241e35`),
        game_triangle(660.0 - mountain_slide, 600.0, 880.0 - mountain_slide, 280.0, 1100.0 - mountain_slide, 600.0, `#151020`),
        game_triangle(1000.0 - mountain_slide, 600.0, 1180.0 - mountain_slide, 240.0, 1360.0 - mountain_slide, 600.0, `#181324`),
        game_triangle(1130.0 - mountain_slide, 600.0, 1198.0 - mountain_slide, 276.0, 1240.0 - mountain_slide, 320.0, `#241e35`)
    ];
    // A hillside of little far buildings climbing the slopes, the city
    // half of city on mountains.
    ridge:a:GAME_Shape = [
        game_rect(60.0 - far_slide, 430.0, 46.0, 170.0, `#1d1729`),
        game_rect(120.0 - far_slide, 390.0, 34.0, 210.0, `#221b31`),
        game_rect(168.0 - far_slide, 440.0, 40.0, 160.0, `#1d1729`),
        game_rect(330.0 - far_slide, 470.0, 44.0, 130.0, `#221b31`),
        game_rect(390.0 - far_slide, 420.0, 30.0, 180.0, `#1d1729`),
        game_rect(560.0 - far_slide, 380.0, 38.0, 220.0, `#221b31`),
        game_rect(610.0 - far_slide, 430.0, 46.0, 170.0, `#1d1729`),
        game_rect(800.0 - far_slide, 410.0, 34.0, 190.0, `#221b31`),
        game_rect(850.0 - far_slide, 460.0, 44.0, 140.0, `#1d1729`),
        game_rect(1010.0 - far_slide, 400.0, 38.0, 200.0, `#221b31`),
        game_rect(1060.0 - far_slide, 450.0, 40.0, 150.0, `#1d1729`)
    ];
    haze:a:GAME_Shape = [game_rect(0.0, 505.0, 800.0, 95.0, `#171320`)];
    mid:a:GAME_Shape = [
        game_rect(40.0 - slide, 340.0, 120.0, 260.0, `#251e30`),
        game_rect(230.0 - slide, 290.0, 90.0, 310.0, `#2b2339`),
        game_rect(360.0 - slide, 380.0, 140.0, 220.0, `#251e30`),
        game_rect(560.0 - slide, 260.0, 70.0, 340.0, `#2b2339`),
        game_rect(640.0 - slide, 320.0, 110.0, 280.0, `#2b2339`),
        game_rect(830.0 - slide, 360.0, 130.0, 240.0, `#251e30`),
        game_rect(1010.0 - slide, 280.0, 90.0, 320.0, `#2b2339`),
        game_rect(1150.0 - slide, 240.0, 76.0, 360.0, `#2b2339`),
        game_rect(1230.0 - slide, 330.0, 150.0, 270.0, `#2b2339`),
        game_rect(1450.0 - slide, 300.0, 100.0, 300.0, `#251e30`),
        game_rect(1600.0 - slide, 360.0, 120.0, 240.0, `#2b2339`)
    ];
    // Little lit windows, the cutesy part: a few homes still awake.
    windows:a:GAME_Shape = [
        game_rect(255.0 - slide, 320.0, 6.0, 8.0, `#8a6d3f`),
        game_rect(275.0 - slide, 356.0, 6.0, 8.0, `#b08d4a`),
        game_rect(70.0 - slide, 380.0, 6.0, 8.0, `#8a6d3f`),
        game_rect(102.0 - slide, 420.0, 6.0, 8.0, `#8a6d3f`),
        game_rect(672.0 - slide, 350.0, 6.0, 8.0, `#b08d4a`),
        game_rect(700.0 - slide, 396.0, 6.0, 8.0, `#8a6d3f`),
        game_rect(1040.0 - slide, 320.0, 6.0, 8.0, `#8a6d3f`),
        game_rect(1066.0 - slide, 372.0, 6.0, 8.0, `#b08d4a`),
        game_rect(1268.0 - slide, 366.0, 6.0, 8.0, `#8a6d3f`),
        game_rect(1486.0 - slide, 340.0, 6.0, 8.0, `#8a6d3f`),
        game_rect(1636.0 - slide, 396.0, 6.0, 8.0, `#b08d4a`)
    ];
    near:a:GAME_Shape = [
        game_rect(90.0 - near_slide, 220.0, 80.0, 380.0, `#3b3150`),
        game_rect(114.0 - near_slide, 260.0, 8.0, 10.0, `#8a6d3f`),
        game_rect(430.0 - near_slide, 300.0, 90.0, 300.0, `#332a42`),
        game_rect(454.0 - near_slide, 336.0, 8.0, 10.0, `#9a7b45`),
        game_rect(486.0 - near_slide, 390.0, 8.0, 10.0, `#8a6d3f`),
        game_rect(730.0 - near_slide, 190.0, 74.0, 410.0, `#3b3150`),
        game_rect(756.0 - near_slide, 234.0, 8.0, 10.0, `#9a7b45`),
        game_rect(1080.0 - near_slide, 280.0, 110.0, 320.0, `#332a42`),
        game_rect(1108.0 - near_slide, 316.0, 8.0, 10.0, `#8a6d3f`),
        game_rect(1150.0 - near_slide, 370.0, 8.0, 10.0, `#9a7b45`),
        game_rect(1390.0 - near_slide, 210.0, 84.0, 390.0, `#3b3150`),
        game_rect(1418.0 - near_slide, 252.0, 8.0, 10.0, `#8a6d3f`),
        game_rect(1760.0 - near_slide, 320.0, 130.0, 280.0, `#332a42`),
        game_rect(1794.0 - near_slide, 356.0, 8.0, 10.0, `#8a6d3f`),
        game_rect(2070.0 - near_slide, 230.0, 78.0, 370.0, `#3b3150`),
        game_rect(2096.0 - near_slide, 270.0, 8.0, 10.0, `#9a7b45`),
        game_rect(2400.0 - near_slide, 290.0, 100.0, 310.0, `#332a42`),
        game_rect(2428.0 - near_slide, 328.0, 8.0, 10.0, `#9a7b45`)
    ];
    behind:a:GAME_Shape = array_concat(array_concat(sky, mountains), array_concat(ridge, haze));
    city:a:GAME_Shape = array_concat(array_concat(mid, windows), near);
    r array_concat(behind, city);
}

f no_shapes():a:GAME_Shape {
    r [];
}

// The built-in font is monospaced and every glyph advances 0.602 of its size,
// so a line can be centred without measuring anything.
f text_left(content:s, centre_x:f, size:f):f {
    width:f = danger(float_from(string_length(content))) * size * 0.602;
    r centre_x - (width / 2.0);
}

f centred_text(content:s, centre_x:f, top_y:f, size:f, tint:s):GAME_Shape {
    r game_text(content, text_left(content, centre_x, size), top_y, size, tint);
}

// One patch of spikes: five teeth on a dark base, which is all a patch ever is.
f spike_shapes(spike:Spike, cam:f):a:GAME_Shape {
    base_x:f = spike.spike_x - cam;
    top_y:f = spike.spike_y;
    r [
        game_rect(base_x, top_y - 4.0, 80.0, 6.0, `#8f4a44`),
        game_triangle(base_x, top_y, base_x + 8.0, top_y - 17.0, base_x + 16.0, top_y, `#e0d7e8`),
        game_triangle(base_x + 16.0, top_y, base_x + 24.0, top_y - 17.0, base_x + 32.0, top_y, `#e0d7e8`),
        game_triangle(base_x + 32.0, top_y, base_x + 40.0, top_y - 17.0, base_x + 48.0, top_y, `#e0d7e8`),
        game_triangle(base_x + 48.0, top_y, base_x + 56.0, top_y - 17.0, base_x + 64.0, top_y, `#e0d7e8`),
        game_triangle(base_x + 64.0, top_y, base_x + 72.0, top_y - 17.0, base_x + 80.0, top_y, `#e0d7e8`)
    ];
}

// A walker shuffles its feet by how far along it is rather than by a clock,
// same as the player does, and looks the way it is walking.
f walker_shapes(foe:Enemy, cam:f):a:GAME_Shape {
    screen_x:f = foe.foe_x - cam;
    swing:f = math_sin(foe.foe_x * 0.09) * 3.0;
    eye_x:f = if {
        foe.foe_dir < 0.0 -> { r 4.0; },
        else -> { r 16.0; }
    };
    r [
        game_rect(screen_x + 2.0 + swing, foe.foe_y + 20.0, 8.0, 6.0, `#8f4a44`),
        game_rect(screen_x + 16.0 - swing, foe.foe_y + 20.0, 8.0, 6.0, `#8f4a44`),
        game_rect(screen_x, foe.foe_y, 26.0, 22.0, `#c9695f`),
        game_rect(screen_x + 3.0, foe.foe_y + 2.0, 20.0, 3.0, `#8f4a44`),
        game_rect(screen_x + eye_x, foe.foe_y + 8.0, 6.0, 7.0, `#1a1020`)
    ];
}

// A flyer flaps at three times its bob, so the wings beat rather than drift.
f flyer_shapes(foe:Enemy, cam:f):a:GAME_Shape {
    screen_x:f = foe.foe_x - cam;
    flap:f = math_sin(foe.foe_bob * 3.0) * 7.0;
    eye_x:f = if {
        foe.foe_dir < 0.0 -> { r 4.0; },
        else -> { r 14.0; }
    };
    r [
        game_triangle(screen_x - 13.0, foe.foe_y + 10.0 - flap, screen_x + 2.0, foe.foe_y + 2.0, screen_x + 2.0, foe.foe_y + 18.0, `#b6a4e8`),
        game_triangle(screen_x + 37.0, foe.foe_y + 10.0 - flap, screen_x + 22.0, foe.foe_y + 2.0, screen_x + 22.0, foe.foe_y + 18.0, `#b6a4e8`),
        game_circle(screen_x + 12.0, foe.foe_y + 12.0, 12.0, `#8f7bd4`),
        game_rect(screen_x + eye_x, foe.foe_y + 8.0, 6.0, 7.0, `#1a1020`)
    ];
}

f enemy_shapes(foe:Enemy, cam:f):a:GAME_Shape {
    if {
        foe.foe_alive == false -> { r no_shapes(); },
        foe.menace == Menace::Walker -> { r walker_shapes(foe, cam); },
        else -> { r flyer_shapes(foe, cam); }
    }
}

// The player drawn as a body with two legs. On the ground the legs swing
// with distance walked, so the cycle speeds up with the run and freezes on
// stopping, no animation clock needed. In the air they tuck. The eye looks
// where the player is going.
f player_shapes(screen_x:f, world_x:f, pos_y:f, vel_x:f, vel_y:f):a:GAME_Shape {
    moving:b = math_abs(vel_x) > 0.02;
    grounded:b = vel_y == 0.0;
    swing:f = if {
        moving && grounded -> { r math_sin(world_x * 0.075) * 5.0; },
        else -> { r 0.0; }
    };
    legs:a:GAME_Shape = if {
        grounded -> {
            r [
                game_rect(screen_x + 3.0 + swing, pos_y + 26.0, 8.0, 10.0, `#3f9e93`),
                game_rect(screen_x + 17.0 - swing, pos_y + 26.0, 8.0, 10.0, `#3f9e93`)
            ];
        },
        else -> {
            r [
                game_rect(screen_x + 5.0, pos_y + 26.0, 8.0, 7.0, `#3f9e93`),
                game_rect(screen_x + 15.0, pos_y + 26.0, 8.0, 7.0, `#3f9e93`)
            ];
        }
    };
    eye_x:f = if {
        vel_x < -0.02 -> { r 6.0; },
        else -> { r 17.0; }
    };
    body:a:GAME_Shape = [
        game_rect(screen_x, pos_y, 28.0, 27.0, `#7bc4b8`),
        game_rect(screen_x + eye_x, pos_y + 9.0, 5.0, 7.0, `#101018`)
    ];
    r array_concat(body, legs);
}

// A pad's plate brightens while its control is being asked for, whether the
// asking came from a key or a finger, so the keyboard lights them too.
f pad_plate_color(pressed:b):s {
    if {
        pressed -> { r `#7bc4b866`; },
        else -> { r `#3b315055`; }
    }
}

f pad_ink_color(pressed:b):s {
    if {
        pressed -> { r `#f4fbf9ee`; },
        else -> { r `#e8ded188`; }
    }
}

// The pads as they look: faint plates with a paler glyph, dim enough to sit
// under the game rather than on top of it. The jump pad draws a figure
// leaving a line of ground, which reads as jumping where an arrow alone
// reads as up. The restart pad up in the corner is a letter, because the key
// that does the same thing is that letter.
f control_pads(state:Platformer):a:GAME_Shape {
    left:a:f = left_pad();
    right:a:f = right_pad();
    jump:a:f = jump_pad();
    reset:a:f = reset_pad();
    left_x:f = danger(array_get(left, 0));
    right_x:f = danger(array_get(right, 0));
    jump_x:f = danger(array_get(jump, 0));
    reset_x:f = danger(array_get(reset, 0));
    jump_ink:s = pad_ink_color(state.pressing_jump);
    r [
        game_rect(left_x, 480.0, 74.0, 74.0, pad_plate_color(state.pressing_left)),
        game_triangle(left_x + 48.0, 500.0, left_x + 48.0, 534.0, left_x + 22.0, 517.0, pad_ink_color(state.pressing_left)),
        game_rect(right_x, 480.0, 74.0, 74.0, pad_plate_color(state.pressing_right)),
        game_triangle(right_x + 26.0, 500.0, right_x + 26.0, 534.0, right_x + 52.0, 517.0, pad_ink_color(state.pressing_right)),
        game_rect(jump_x, 470.0, 94.0, 94.0, pad_plate_color(state.pressing_jump)),
        game_triangle(jump_x + 47.0, 487.0, jump_x + 29.0, 512.0, jump_x + 65.0, 512.0, jump_ink),
        game_rect(jump_x + 41.0, 510.0, 12.0, 20.0, jump_ink),
        game_rect(jump_x + 27.0, 541.0, 40.0, 6.0, jump_ink),
        game_rect(reset_x, 14.0, 62.0, 62.0, pad_plate_color(false)),
        centred_text(`R`, reset_x + 31.0, 30.0, 30.0, pad_ink_color(false))
    ];
}

// The card the title screen puts over a still level one.
f title_card():a:GAME_Shape {
    r [
        game_rect(0.0, 0.0, 800.0, 600.0, `#101018bb`),
        centred_text(`NAIL PLATFORMER`, 400.0, 150.0, 46.0, `#e9c46a`),
        centred_text(`five levels, and something on every one of them`, 400.0, 225.0, 18.0, `#e8ded1`),
        centred_text(`arrows or A and D run, Space jumps, R starts the level over`, 400.0, 262.0, 16.0, `#9a94a8`),
        centred_text(`on a phone, the pads in the corners do all three`, 400.0, 292.0, 16.0, `#9a94a8`),
        centred_text(`land on what moves, and it stops moving`, 400.0, 330.0, 16.0, `#9a94a8`),
        game_rect(250.0, 392.0, 300.0, 84.0, `#7bc4b833`),
        game_rect_outline(250.0, 392.0, 300.0, 84.0, 2.0, `#7bc4b8`),
        centred_text(`START`, 400.0, 412.0, 40.0, `#f4fbf9`),
        centred_text(`press Space or touch anywhere`, 400.0, 500.0, 16.0, `#757575`)
    ];
}

// Between levels. The number on the card is what this level was worth, and the
// running total underneath is the game so far.
f cleared_card(level:i, score:i, total:i, deaths:i):a:GAME_Shape {
    r [
        game_rect(0.0, 0.0, 800.0, 600.0, `#101018aa`),
        game_rect(160.0, 150.0, 480.0, 280.0, `#181226`),
        game_rect_outline(160.0, 150.0, 480.0, 280.0, 3.0, `#6d5a7e`),
        centred_text(string_concat([`Level `, string_from(level), ` clear`]), 400.0, 180.0, 38.0, `#e9c46a`),
        centred_text(string_concat([`coins on this one `, string_from(score), ` of `, string_from(array_length(level_coins(level)))]), 400.0, 244.0, 20.0, `#e8ded1`),
        centred_text(string_concat([`coins so far `, string_from(total), `, deaths `, string_from(deaths)]), 400.0, 274.0, 20.0, `#9a94a8`),
        game_rect(300.0, 320.0, 200.0, 66.0, `#7bc4b833`),
        game_rect_outline(300.0, 320.0, 200.0, 66.0, 2.0, `#7bc4b8`),
        centred_text(`NEXT`, 400.0, 336.0, 34.0, `#f4fbf9`),
        centred_text(`press Space or touch anywhere`, 400.0, 400.0, 15.0, `#757575`)
    ];
}

// The end of the game, which is the only place the whole run is added up.
f finished_card(total:i, deaths:i):a:GAME_Shape {
    r [
        game_rect(0.0, 0.0, 800.0, 600.0, `#101018aa`),
        game_rect(160.0, 150.0, 480.0, 280.0, `#181226`),
        game_rect_outline(160.0, 150.0, 480.0, 280.0, 3.0, `#e9c46a`),
        centred_text(`You made it!`, 400.0, 178.0, 42.0, `#e9c46a`),
        centred_text(`all five levels, end to end`, 400.0, 238.0, 20.0, `#e8ded1`),
        centred_text(string_concat([`coins `, string_from(total), ` of `, string_from(total_coins()), `, deaths `, string_from(deaths)]), 400.0, 272.0, 20.0, `#e8ded1`),
        game_rect(270.0, 320.0, 260.0, 66.0, `#7bc4b833`),
        game_rect_outline(270.0, 320.0, 260.0, 66.0, 2.0, `#7bc4b8`),
        centred_text(`PLAY AGAIN`, 400.0, 338.0, 30.0, `#f4fbf9`),
        centred_text(`press Space or touch anywhere`, 400.0, 400.0, 15.0, `#757575`)
    ];
}

// The name of the level, for as long as the level has just started.
f intro_card(level:i, intro_ms:f):a:GAME_Shape {
    if {
        intro_ms <= 0.0 -> { r no_shapes(); },
        else -> {
            r [
                centred_text(string_concat([`Level `, string_from(level)]), 400.0, 120.0, 22.0, `#9a94a8`),
                centred_text(level_name(level), 400.0, 150.0, 34.0, `#e9c46a`)
            ];
        }
    }
}

f overlay_shapes(state:Platformer):a:GAME_Shape {
    if {
        state.mode == Mode::Title -> { r title_card(); },
        state.mode == Mode::Cleared -> { r cleared_card(state.level, taken_count(state.coins), state.banked, state.deaths); },
        state.mode == Mode::Finished -> { r finished_card(state.banked, state.deaths); },
        else -> { r intro_card(state.level, state.intro_ms); }
    }
}

// Physics runs on its own fixed step, so a frame usually lands part way
// between two of them. This says what part way looks like: the things that
// move slide between where they were and where they are, and everything
// else is taken from the newer state as it stands. Drawing the newer state
// alone would judder on a screen that refreshes faster than physics runs.
f mix(before:f, after:f, part:f):f {
    r before + ((after - before) * part);
}

f blend_enemy(before:Enemy, after:Enemy, part:f):Enemy {
    r Enemy {
        foe_x = mix(before.foe_x, after.foe_x, part),
        foe_y = mix(before.foe_y, after.foe_y, part),
        foe_from = after.foe_from, foe_to = after.foe_to, foe_dir = after.foe_dir,
        foe_pace = after.foe_pace, foe_home = after.foe_home, foe_bob = after.foe_bob,
        menace = after.menace, foe_alive = after.foe_alive
    };
}

// Enemies are paired by position in the array, which holds because a step only
// ever rewrites the array it was given. A death hands back a fresh set, and
// the length check is what keeps that frame from pairing the wrong ones.
f blend_enemies(before:a:Enemy, after:a:Enemy, part:f):a:Enemy {
    if {
        array_length(before) != array_length(after) -> { r after; },
        else -> {}
    }
    r map index in array_range(0, array_length(after)) {
        y blend_enemy(danger(array_get(before, index)), danger(array_get(after, index)), part);
    };
}

f blend(previous:Platformer, current:Platformer, part:f):Platformer {
    r Platformer {
        mode = current.mode,
        level = current.level,
        banked = current.banked,
        deaths = current.deaths,
        intro_ms = current.intro_ms,
        player_x = mix(previous.player_x, current.player_x, part),
        player_y = mix(previous.player_y, current.player_y, part),
        vel_x = current.vel_x,
        vel_y = current.vel_y,
        coyote_ms = current.coyote_ms,
        camera_x = mix(previous.camera_x, current.camera_x, part),
        coins = current.coins,
        foes = blend_enemies(previous.foes, current.foes, part),
        jump_held = current.jump_held,
        reset_held = current.reset_held,
        tap_held = current.tap_held,
        step_phase = current.step_phase,
        pressing_left = current.pressing_left,
        pressing_right = current.pressing_right,
        pressing_jump = current.pressing_jump,
        done = current.done
    };
}

f view(state:Platformer):GAME_Frame {
    cam:f = state.camera_x;
    level:i = state.level;

    plat_shapes:a:GAME_Shape = map plat in level_platforms(level) {
        y game_rect(plat.plat_x - cam, plat.plat_y, plat.plat_w, plat.plat_h, plat.tint);
    };
    remaining:a:Coin = filter coin in state.coins {
        y coin.taken == false;
    };
    coin_shapes:a:GAME_Shape = map coin in remaining {
        y game_circle(coin.coin_x - cam, coin.coin_y, 7.0, `#e9c46a`);
    };
    score:i = taken_count(state.coins);

    // Spikes and enemies are several shapes each, so they are gathered rather
    // than mapped: an array of arrays is not a thing Nail has.
    hazard_shapes:a:GAME_Shape = [];
    for spike in level_spikes(level) {
        hazard_shapes = array_concat(hazard_shapes, spike_shapes(spike, cam));
    }
    foe_shapes:a:GAME_Shape = [];
    for foe in state.foes {
        foe_shapes = array_concat(foe_shapes, enemy_shapes(foe, cam));
    }

    // The goal flag, the player, and the numbers on screen.
    goal_x:f = flag_x(level);
    goal:a:GAME_Shape = [
        game_rect(goal_x - cam, 420.0, 8.0, 140.0, `#e8ded1`),
        game_rect(goal_x + 8.0 - cam, 420.0, 40.0, 26.0, `#e9c46a`)
    ];
    player:a:GAME_Shape = player_shapes(state.player_x - cam, state.player_x, state.player_y, state.vel_x, state.vel_y);
    hud:a:GAME_Shape = [
        game_text(string_concat([`level `, string_from(level), `/`, string_from(level_count()), `   coins `, string_from(score), `/`, string_from(array_length(level_coins(level))), `   deaths `, string_from(state.deaths)]), 20.0, 20.0, 24.0, `#e9c46a`),
        game_text(`Arrows or A and D move, Space jumps, R restarts the level, Esc quits`, 20.0, 52.0, 15.0, `#757575`)
    ];

    // The pads are for playing with, so they show while there is something to
    // play and stay out of the way of every card.
    pads:a:GAME_Shape = if {
        state.mode == Mode::Running -> { r control_pads(state); },
        else -> { r no_shapes(); }
    };

    world:a:GAME_Shape = array_concat(array_concat(backdrop_shapes(cam, level), plat_shapes), array_concat(hazard_shapes, array_concat(coin_shapes, goal)));
    front:a:GAME_Shape = array_concat(array_concat(foe_shapes, player), array_concat(hud, array_concat(pads, overlay_shapes(state))));

    r GAME_Frame {
        shapes = array_concat(world, front),
        background = sky_tint(level),
        quit = state.done
    };
}

config:GAME_Config = GAME_Config { title = `Nail platformer`, width = 800, height = 600, target_fps = 120, pixel_size = 2, physics_hz = 60 };

final_state:Platformer = danger(game_run(config, new_game()));
print(string_concat([`closed on level `, string_from(final_state.level), ` with `, string_from(coins_so_far(final_state)), ` coins of `, string_from(total_coins()), ` and `, string_from(final_state.deaths), ` deaths`]));
