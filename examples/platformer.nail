nail latest
// A scrolling platformer in flat colours, in a real window.
//
// Five levels, each one wider and meaner than the last. Run and jump, take the
// coins, stomp what walks and what flies, and touch the flag at the far right.
// The whole game is pure functions over one state struct: `view` turns state
// into a frame of rectangles and `update` folds the input into the next state.
// `game_run` does the rest.
//
// Everything the game can be asked for has two ways in, a key and a place on
// the screen to touch, so a phone plays the same game a keyboard does. Arrows
// or A and D move, Space or Up jumps, R restarts the level, Esc quits, and the
// pads in the corners say all of it by finger. The screens between levels are
// the same story: press Space or touch anywhere.
//
// All motion is multiplied by input.delta_ms, so the game plays at the same
// speed whatever frame rate the machine manages.

// What a thing that wants you dead does. Walkers pace a stretch of ground and
// can be stomped from above. Flyers do the same in the air, bobbing as they go.
enum Menace {
    Walker,
    Flyer
}

// Which screen the game is on. Everything except Running is a card over a
// frozen level, and all of them leave on the same press.
enum Mode {
    Title,
    Running,
    Cleared,
    Finished
}

// One coin. Taken coins stay in the array so the counter knows the total.
struct Coin {
    coin_x:f,
    coin_y:f,
    taken:b
}

// One solid rectangle the player can stand on or bump into.
struct Platform {
    plat_x:f,
    plat_y:f,
    plat_w:f,
    plat_h:f,
    tint:s
}

// A patch of spikes, always five teeth and eighty pixels wide, sitting on top
// of whatever surface it names. Touching one costs the run.
struct Spike {
    spike_x:f,
    spike_y:f
}

// One walker or flyer. It paces between foe_from and foe_to, foe_dir says
// which way it is going at the moment, and foe_bob is how far a flyer is
// through its bob. Dead ones stay in the array so nothing has to be rebuilt,
// they simply stop being drawn and stop being dangerous.
struct Enemy {
    foe_x:f,
    foe_y:f,
    foe_from:f,
    foe_to:f,
    foe_dir:f,
    foe_pace:f,
    foe_home:f,
    foe_bob:f,
    menace:Menace,
    foe_alive:b
}

// What a vertical collision pass decided: where the player ended up,
// what happened to the fall speed, and whether feet found ground.
struct Landing {
    land_y:f,
    land_vel:f,
    grounded:b
}

// The whole game in one value. banked is the coins from levels already
// finished, so the level counter can stay a level counter.
//
// The three held flags remember what was under a finger last frame, so that
// holding something down is one press and not a press every frame: jump_held
// for the jump pad, reset_held for the restart pad, tap_held for a finger
// anywhere at all, which is what the cards between levels wait on. They are
// three flags and not one because running into the flag with a thumb still on
// the right pad has to leave the card up, while reaching for restart with that
// same thumb still down has to work.
//
// step_phase is how far the player has walked since the last footstep sounded.
// The three pressing flags are what the player is asking for right now,
// whether by key or by finger, so the pads can light up.
struct Platformer {
    mode:Mode,
    level:i,
    banked:i,
    deaths:i,
    intro_ms:f,
    player_x:f,
    player_y:f,
    vel_x:f,
    vel_y:f,
    coyote_ms:f,
    camera_x:f,
    coins:a:Coin,
    foes:a:Enemy,
    jump_held:b,
    reset_held:b,
    tap_held:b,
    step_phase:f,
    pressing_left:b,
    pressing_right:b,
    pressing_jump:b,
    done:b
}

// The pieces a level is built from. Naming them once keeps the level tables
// below readable as level tables rather than as walls of numbers.
f ground(from_x:f, to_x:f):Platform {
    r Platform { plat_x = from_x, plat_y = 560.0, plat_w = to_x - from_x, plat_h = 40.0, tint = `#e8ded1` };
}

f shelf(pos_x:f, pos_y:f, width:f):Platform {
    r Platform { plat_x = pos_x, plat_y = pos_y, plat_w = width, plat_h = 18.0, tint = `#e8ded1` };
}

f ledge(pos_x:f, pos_y:f, width:f):Platform {
    r Platform { plat_x = pos_x, plat_y = pos_y, plat_w = width, plat_h = 18.0, tint = `#d98c9e` };
}

f coin_at(pos_x:f, pos_y:f):Coin {
    r Coin { coin_x = pos_x, coin_y = pos_y, taken = false };
}

f spikes_at(pos_x:f, top_y:f):Spike {
    r Spike { spike_x = pos_x, spike_y = top_y };
}

// A walker stands on a surface, so its top is twenty six pixels above it.
f walker(from_x:f, to_x:f, top_y:f, pace:f):Enemy {
    r Enemy {
        foe_x = from_x, foe_y = top_y, foe_from = from_x, foe_to = to_x, foe_dir = 1.0,
        foe_pace = pace, foe_home = top_y, foe_bob = 0.0, menace = Menace::Walker, foe_alive = true
    };
}

// A flyer hangs around a height rather than resting on anything.
f flyer(from_x:f, to_x:f, home_y:f, pace:f):Enemy {
    r Enemy {
        foe_x = from_x, foe_y = home_y, foe_from = from_x, foe_to = to_x, foe_dir = 1.0,
        foe_pace = pace, foe_home = home_y, foe_bob = 0.0, menace = Menace::Flyer, foe_alive = true
    };
}

f level_count():i {
    r 5;
}

// How wide each level is. The flag stands a hundred and twenty pixels short of
// the far edge, and the camera stops eight hundred short of it, which is the
// width of the window.
f level_span(level:i):f {
    if {
        level == 1 -> { r 3200.0; },
        level == 2 -> { r 3400.0; },
        level == 3 -> { r 3600.0; },
        level == 4 -> { r 3800.0; },
        else -> { r 4000.0; }
    }
}

f flag_x(level:i):f {
    r level_span(level) - 120.0;
}

f level_name(level:i):s {
    if {
        level == 1 -> { r `Warm up`; },
        level == 2 -> { r `Something walks here`; },
        level == 3 -> { r `Wings over the gaps`; },
        level == 4 -> { r `The long night`; },
        else -> { r `The tower`; }
    }
}

// Level one. Four stretches of ground with three pits between them and a
// staircase of ledges over each, plus one slow walker to meet.
f level_one_platforms():a:Platform {
    r [
        ground(0.0, 900.0), ground(1020.0, 1800.0), ground(1960.0, 2600.0), ground(2760.0, 3200.0),
        ledge(330.0, 445.0, 140.0), shelf(540.0, 345.0, 120.0), ledge(915.0, 470.0, 95.0),
        shelf(1150.0, 445.0, 130.0), ledge(1350.0, 335.0, 120.0), shelf(1560.0, 430.0, 110.0),
        ledge(1830.0, 465.0, 100.0), shelf(2050.0, 445.0, 130.0), ledge(2250.0, 340.0, 120.0),
        shelf(2440.0, 240.0, 110.0), ledge(2625.0, 460.0, 110.0), ledge(2900.0, 440.0, 130.0)
    ];
}

f level_one_coins():a:Coin {
    r [
        coin_at(400.0, 410.0), coin_at(600.0, 310.0), coin_at(770.0, 525.0), coin_at(962.0, 435.0),
