// Every request goes to handle_request. The server passes it the request and
// whatever state the config was built with.
f handle_request(request:HTTP_Request, state:h<s,s>):HTTP_Response {
    r HTTP_Response {
        status = 200,
        body = `<h1>Hello from Nail!</h1>`,
        content_type = `text/html`,
        headers = hashmap_new()
    };
}

config:HTTP_Config = HTTP_Config {
    static_mounts = [],
    max_body_bytes = 0,
    timeout_seconds = 0,
    state = hashmap_new(),
    cors_origins = [],
    security_headers = true,
    rate_limit_per_minute = 0,
    rate_limit_message = ``
};

http_server(3000, config);
