nail latest
// A 3D model viewer: drag to orbit, scroll to zoom, Esc to quit.
//
// The model is any glTF file. On a real machine the path is read from disk,
// in the browser build the very same program fetches it as a URL, which is
// how this runs on the website. Textures are not read, triangles take their
// material's base colour, one fixed light shades them - the low-poly look is
// the point.
//
// There is no renderer object anywhere below. game3d_mesh is a function from
// a camera and a mesh to an array of flat triangles, and the frame is data
// like every other frame.

struct Viewer {
    yaw:f,
    pitch:f,
    distance:f,
    last_mouse_x:f,
    last_mouse_y:f,
    mesh:i,
    done:b
}

f camera_of(state:Viewer):GAME3D_Camera {
    // The eye orbits the origin on a sphere: yaw walks around it, pitch
    // tilts above and below, distance is the zoom.
    flat:f = math_cos(state.pitch) * state.distance;
    r GAME3D_Camera {
        position_x = math_sin(state.yaw) * flat,
        position_y = math_sin(state.pitch) * state.distance,
        position_z = 0.0 - (math_cos(state.yaw) * flat),
        target_x = 0.0,
        target_y = 0.0,
        target_z = 0.0,
        field_of_view = 55.0,
        viewport_width = 900.0,
        viewport_height = 640.0
    };
}

f view(state:Viewer):GAME_Frame {
    camera:GAME3D_Camera = camera_of(state);
    model:a:GAME_Shape = danger(game3d_mesh(camera, state.mesh, 0.0, 0.0, 0.0, 0.0, 1.4, ``));

    // A ground square under the model, drawn as world-space wires.
    edge_one:a:GAME_Shape = game3d_line(camera, -1.0, -0.75, -1.0, 1.0, -0.75, -1.0, 1.0, `#3a3a4a`);
    edge_two:a:GAME_Shape = game3d_line(camera, 1.0, -0.75, -1.0, 1.0, -0.75, 1.0, 1.0, `#3a3a4a`);
    edge_three:a:GAME_Shape = game3d_line(camera, 1.0, -0.75, 1.0, -1.0, -0.75, 1.0, 1.0, `#3a3a4a`);
    edge_four:a:GAME_Shape = game3d_line(camera, -1.0, -0.75, 1.0, -1.0, -0.75, -1.0, 1.0, `#3a3a4a`);
    help:GAME_Shape = game_text(`drag to orbit, scroll to zoom, Esc quits`, 20.0, 600.0, 18.0, `#757575`);

    floor:a:GAME_Shape = array_concat(edge_one, edge_two);
    floor_two:a:GAME_Shape = array_concat(edge_three, edge_four);
    scene:a:GAME_Shape = array_concat(array_concat(floor, floor_two), model);
    shapes:a:GAME_Shape = array_concat(scene, [help]);

    r GAME_Frame {
        shapes = shapes,
        background = `#101018`,
        quit = state.done
    };
}

f update(state:Viewer, input:GAME_Input):Viewer {
    if {
        array_contains(input.keys_pressed, `Esc`) -> {
            r Viewer { yaw = state.yaw, pitch = state.pitch, distance = state.distance, last_mouse_x = input.mouse_x, last_mouse_y = input.mouse_y, mesh = state.mesh, done = true };
        },
        else -> {
            // Dragging orbits, idling spins slowly, the wheel zooms.
            yaw:f = if {
                input.mouse_down -> { r state.yaw + ((input.mouse_x - state.last_mouse_x) * 0.008); },
                else -> { r state.yaw + (0.0004 * input.delta_ms); }
            };
            pitch:f = if {
                input.mouse_down -> { r math_clamp(state.pitch + ((input.mouse_y - state.last_mouse_y) * 0.008), -1.3, 1.3); },
                else -> { r state.pitch; }
            };
            distance:f = math_clamp(state.distance - (input.scroll * 0.2), 1.1, 8.0);
            r Viewer { yaw = yaw, pitch = pitch, distance = distance, last_mouse_x = input.mouse_x, last_mouse_y = input.mouse_y, mesh = state.mesh, done = false };
        }
    }
}

config:GAME_Config = GAME_Config { title = `Nail model viewer`, width = 900, height = 640, target_fps = 60, pixel_size = 1, physics_hz = 0 };
monument:i = danger(game3d_mesh_load(`monument.glb`));
start:Viewer = Viewer { yaw = 0.6, pitch = 0.35, distance = 2.6, last_mouse_x = 0.0, last_mouse_y = 0.0, mesh = monument, done = false };

final_state:Viewer = danger(game_run(config, start));
print(`model viewer closed`);
