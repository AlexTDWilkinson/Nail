// Pong against the wall, in a real window.
//
// This is the game the test suite checks as pure functions, run for real:
// `game_run` opens the window, reads the keyboard, draws each frame and
// paces the loop, while the game itself stays two functions and a struct.
// Up and Down move the paddle, Esc quits. Build and run it like any other
// Nail program - there is nothing to install first.

struct Pong {
    paddle_y:f,
    ball_x:f,
    ball_y:f,
    ball_dx:f,
    ball_dy:f,
    hits:i,
    done:b
}

f view(state:Pong):GAME_Frame {
    court:GAME_Shape = game_rect_outline(0.0, 0.0, 800.0, 600.0, 4.0, `#757575`);
    paddle:GAME_Shape = game_rect(10.0, state.paddle_y, 16.0, 100.0, `white`);
    ball:GAME_Shape = game_circle(state.ball_x, state.ball_y, 8.0, `#fdd835`);
    score:GAME_Shape = game_text(string_concat([`hits: `, string_from(state.hits)]), 20.0, 20.0, 28.0, `white`);
    help:GAME_Shape = game_text(`Up and Down move, Esc quits`, 20.0, 560.0, 18.0, `#757575`);

    r GAME_Frame {
        shapes = [court, paddle, ball, score, help],
        background = `#101018`,
        quit = state.done
    };
}

f step_paddle(state:Pong, input:GAME_Input):f {
    if {
        array_contains(input.keys_down, `Up`) -> {
            r math_max(state.paddle_y - (0.5 * input.delta_ms), 0.0);
        },
        array_contains(input.keys_down, `Down`) -> {
            r math_min(state.paddle_y + (0.5 * input.delta_ms), 500.0);
        },
        else -> {
            r state.paddle_y;
        }
    }
}

f update(state:Pong, input:GAME_Input):Pong {
    if {
        array_contains(input.keys_pressed, `Esc`) -> {
            r Pong { paddle_y = state.paddle_y, ball_x = state.ball_x, ball_y = state.ball_y, ball_dx = state.ball_dx, ball_dy = state.ball_dy, hits = state.hits, done = true };
        },
        else -> {
            paddle_y:f = step_paddle(state, input);
            ball_x:f = state.ball_x + (state.ball_dx * input.delta_ms);
            ball_y:f = state.ball_y + (state.ball_dy * input.delta_ms);

            // Bounce off the top, bottom and right walls.
            dy:f = if {
                ball_y < 8.0 -> { r math_abs(state.ball_dy); },
                ball_y > 592.0 -> { r 0.0 - math_abs(state.ball_dy); },
                else -> { r state.ball_dy; }
            };
            dx_wall:f = if {
                ball_x > 792.0 -> { r 0.0 - math_abs(state.ball_dx); },
                else -> { r state.ball_dx; }
            };

            // The paddle sends it back and counts the hit. A miss past the
            // left edge serves again from the middle and the count starts over.
            hit:b = ball_x < 34.0 && ball_y > paddle_y && ball_y < (paddle_y + 100.0);
            if {
                hit -> {
                    r Pong { paddle_y = paddle_y, ball_x = 34.0, ball_y = ball_y, ball_dx = math_abs(dx_wall), ball_dy = dy, hits = state.hits + 1, done = false };
                },
                ball_x < 0.0 -> {
                    r Pong { paddle_y = paddle_y, ball_x = 400.0, ball_y = 300.0, ball_dx = 0.0 - math_abs(state.ball_dx), ball_dy = 0.25, hits = 0, done = false };
                },
                else -> {
                    r Pong { paddle_y = paddle_y, ball_x = ball_x, ball_y = ball_y, ball_dx = dx_wall, ball_dy = dy, hits = state.hits, done = false };
                }
            }
        }
    }
}

config:GAME_Config = GAME_Config { title = `Nail Pong`, width = 800, height = 600, target_fps = 60 };
start:Pong = Pong { paddle_y = 250.0, ball_x = 400.0, ball_y = 300.0, ball_dx = -0.3, ball_dy = 0.25, hits = 0, done = false };

final_state:Pong = danger(game_run(config, start));
print(string_concat([`you kept it alive for `, string_from(final_state.hits), ` hits`]));
