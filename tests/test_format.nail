// Numbers turned into the text a person reads: prices, sizes, counts, places.

test_assert_equal_string(format_decimals(3.5, 2), `3.50`, `a price keeps its trailing zero`);
test_assert_equal_string(format_thousands(1234567), `1,234,567`, `a large count is grouped`);
test_assert_equal_string(format_thousands(-1000), `-1,000`, `a negative count keeps its sign`);
test_assert_equal_string(format_thousands_float(1234.5, 2), `1,234.50`, `a money column is grouped and padded`);

test_assert_equal_string(format_currency(1234.5, `$`), `$1,234.50`, `an amount of money`);
test_assert_equal_string(format_currency(-9.99, `$`), `-$9.99`, `a refund`);

test_assert_equal_string(format_percent(0.125, 1), `12.5%`, `a fraction as a percentage`);
test_assert_equal_string(format_percent(1.0, 0), `100%`, `all of it`);

test_assert_equal_string(format_bytes(512), `512 B`, `whole bytes need no decimal`);
test_assert_equal_string(format_bytes(1536), `1.5 KB`, `a size in the unit that fits`);
test_assert_equal_string(format_bytes(1048576), `1.0 MB`, `a megabyte`);

test_assert_equal_string(format_compact(999), `999`, `a small count is left alone`);
test_assert_equal_string(format_compact(1200), `1.2k`, `a thousand shortens`);
test_assert_equal_string(format_compact(3400000), `3.4M`, `a million shortens`);

test_assert_equal_string(format_ordinal(1), `1st`, `first`);
test_assert_equal_string(format_ordinal(2), `2nd`, `second`);
test_assert_equal_string(format_ordinal(3), `3rd`, `third`);
test_assert_equal_string(format_ordinal(11), `11th`, `the teens break the pattern`);
test_assert_equal_string(format_ordinal(21), `21st`, `and the pattern resumes after them`);

test_assert_equal_string(format_plural(1, `file`, `files`), `1 file`, `one of a thing`);
test_assert_equal_string(format_plural(0, `file`, `files`), `0 files`, `none of a thing`);
test_assert_equal_string(format_plural(2, `mouse`, `mice`), `2 mice`, `a word English does not pluralise by rule`);

test_assert_equal_string(format_list([`a`, `b`, `c`], `and`), `a, b and c`, `a list read as a sentence`);
test_assert_equal_string(format_list([`a`, `b`], `or`), `a or b`, `two items take no comma`);
test_assert_equal_string(format_list([`a`], `and`), `a`, `one item is itself`);

report:s = string_concat([
    format_thousands(48293),
    ` requests, `,
    format_percent(0.9987, 2),
    ` served in `,
    format_decimals(1.5, 1),
    `ms, log at `,
    format_bytes(1073741824),
]);
print(report);
