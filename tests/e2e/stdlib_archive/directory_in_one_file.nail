nail latest
// E2E: a directory into one archive file and back out again
danger(fs_create_dir(`source/nested`));
danger(fs_write(`source/top.txt`, `the top file`));
danger(fs_write(`source/nested/under.txt`, `the nested file`));

danger(archive_zip_create(`backup.zip`, `source`));
print(danger(fs_is_file(`backup.zip`)));
print(danger(archive_zip_list(`backup.zip`)));
danger(archive_zip_extract(`backup.zip`, `unpacked`));
print(danger(fs_read(`unpacked/top.txt`)));
print(danger(fs_read(`unpacked/nested/under.txt`)));

danger(archive_targz_create(`backup.tar.gz`, `source`));
print(danger(archive_targz_list(`backup.tar.gz`)));
danger(archive_targz_extract(`backup.tar.gz`, `from_tar`));
print(danger(fs_read(`from_tar/nested/under.txt`)));

f refused(err:e):v { }
safe(archive_zip_create(`never.zip`, `no_such_directory`), refused);
print(danger(fs_is_file(`never.zip`)));
