// E2E: composing helper functions in nested calls
f max_of(first:i, second:i):i {
    r if { first >= second -> { r first; }, else -> { r second; } };
}
f min_of(first:i, second:i):i {
    r if { first <= second -> { r first; }, else -> { r second; } };
}
f clamp_val(num:i, low:i, high:i):i {
    r max_of(low, min_of(num, high));
}
print(clamp_val(15, 0, 10));
print(clamp_val(-3, 0, 10));
print(clamp_val(5, 0, 10));
