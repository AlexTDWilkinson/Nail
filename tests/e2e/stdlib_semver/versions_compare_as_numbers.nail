// E2E: semver_* compares versions as numbers, not as text
print(semver_valid(`1.4.2`));
print(semver_valid(`1.4`));
print(danger(semver_compare(`1.10.0`, `1.9.0`)));
print(danger(semver_compare(`1.9.0`, `1.10.0`)));
print(danger(semver_compare(`1.0.0+monday`, `1.0.0+tuesday`)));
print(danger(semver_compare(`1.0.0-rc.1`, `1.0.0`)));
print(danger(semver_is_newer(`2.0.0`, `1.9.9`)));
print(danger(semver_major(`1.4.2`)));
print(danger(semver_prerelease(`1.0.0-rc.1`)));
print(danger(semver_bump_major(`1.9.3`)));
print(danger(semver_bump_minor(`1.9.3`)));
print(danger(semver_satisfies(`1.5.0`, `>=1.2.0, <2.0.0`)));
print(danger(semver_satisfies(`2.0.0`, `^1.2.3`)));
print(danger(semver_satisfies(`1.2.9`, `~1.2.3`)));
print(danger(semver_sort([`1.10.0`, `1.9.0`, `2.0.0`])));
print(danger(semver_newest([`1.9.0`, `1.10.0`, `1.2.0`])));
