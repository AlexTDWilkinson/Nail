// E2E: inner loop break returns control to the outer loop
loop outer_idx {
    if {
        outer_idx >= 2 -> { break; },
        else -> {
            loop inner_idx {
                if { inner_idx >= 2 -> { break; }, else -> { print(outer_idx, inner_idx); } }
            }
        }
    }
}
print(`done`);
