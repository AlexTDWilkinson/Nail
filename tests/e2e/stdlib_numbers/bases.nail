// E2E: reading and writing numbers in other bases
print(danger(int_from_hex(`ff`)));
print(danger(int_from_hex(`0xFF`)));
print(danger(int_from_hex(`-0x10`)));
print(danger(int_from_radix(`1011`, 2)));
print(danger(int_from_radix(`0b1011`, 2)));
print(danger(int_from_radix(`777`, 8)));
print(danger(int_from_radix(`zz`, 36)));
print(danger(int_to_radix(255, 16)));
print(danger(int_to_radix(255, 2)));
print(danger(int_to_radix(0, 2)));
print(danger(int_to_radix(-16, 16)));
f rejected(err:e):i { r -1; }
print(safe(int_from_radix(`12`, 2), rejected));
print(safe(int_from_radix(`10`, 99), rejected));
