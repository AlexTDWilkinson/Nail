// E2E: find returning a struct matched on a field condition
struct City { name:s, population:i }
cities:a:City = [City { name = `Oslo`, population = 700 }, City { name = `Rome`, population = 2800 }];
big_city:City = danger(find city in cities { y city.population > 1000; });
print(big_city.name);
