// E2E: a boolean key splits an array in two, which is what other languages
// call partition. A side with nothing on it has no bucket, so the empty array
// is the right fallback rather than an error.
f is_even(number:i):b { r int_is_even(number); }

numbers:a:i = [1, 2, 3, 4, 5, 6];
split:h<b,a:i> = array_group_by(numbers, is_even);
print(hashmap_get_or(split, true, []));
print(hashmap_get_or(split, false, []));
print(danger(hashmap_get(array_count_by(numbers, is_even), true)));

// Everything on one side leaves the other side without a bucket.
all_odd:a:i = [1, 3, 5];
lopsided:h<b,a:i> = array_group_by(all_odd, is_even);
print(hashmap_len(lopsided));
print(hashmap_get_or(lopsided, true, []));
print(hashmap_get_or(lopsided, false, []));
