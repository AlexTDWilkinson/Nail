// E2E: every chart is a whole SVG document, which is a string like any other
daily:a:f = [120.0, 180.0, 150.0, 240.0];
days:a:s = [`mon`, `tue`, `wed`, `thu`];

line_chart:s = danger(chart_line(600.0, 300.0, daily, days, `#2563eb`, `Requests`));
print(string_starts_with(line_chart, `<svg`));
print(string_contains(line_chart, `polyline`));
print(string_contains(line_chart, `Requests`));
print(string_contains(line_chart, `mon`));

bar_chart:s = danger(chart_bar(600.0, 300.0, daily, days, `#16a34a`, `Sales`));
print(string_contains(bar_chart, `<rect`));

scatter_chart:s = danger(chart_scatter(400.0, 400.0, daily, daily, `#dc2626`, ``));
print(string_contains(scatter_chart, `<circle`));

spark:s = danger(chart_sparkline(80.0, 20.0, daily, `#2563eb`));
print(string_contains(spark, `polyline`));
print(string_contains(spark, `<text`));

// A label that is markup cannot break the document it goes into.
risky:a:s = [`<script>`, `a & b`];
two:a:f = [1.0, 2.0];
escaped:s = danger(chart_bar(600.0, 300.0, two, risky, `#000000`, `safe`));
print(string_contains(escaped, `<script>`));
print(string_contains(escaped, `&lt;script&gt;`));

f no_chart(err:e):s { r `refused`; }
print(safe(chart_line(40.0, 40.0, two, days, `#000000`, ``), no_chart));
