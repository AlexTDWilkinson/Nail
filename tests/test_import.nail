nail latest
// Test sandboxed file inclusion: the helper is brought in with import, so
// the compiler proves it only computes. Calling it and printing results
// happens here, on the trusted side.
import(`test_import_helper.nail`)

greeting:s = shout_greeting(`world`);
doubled:i = double_sum([1, 2, 3]);
distance:f = distance_from_zero(-4.5);
print(greeting);
print(`Doubled: `, doubled);
print(`Distance: `, distance);
print(`Prefix: `, sandboxed_prefix);
