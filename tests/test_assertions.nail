nail latest
// Assertions, which a Nail program uses to check itself. Every assertion here
// holds, so the program runs to the end and exits cleanly.

numbers:a:i = [3, 1, 2];
sorted:a:i = array_sort(numbers);
expected:a:i = [1, 2, 3];

test_assert(array_length(numbers) == 3, `the array has three elements`);
test_assert_false(array_length(numbers) == 0, `the array is not empty`);
test_assert_equal_int(array_length(sorted), 3, `sorting keeps every element`);
test_assert_not_equal_int(array_length(sorted), 0, `sorting did not lose everything`);
test_assert_greater_int(array_length(sorted), 2, `more than two elements`);
test_assert_less_int(array_length(sorted), 4, `fewer than four elements`);
test_assert_between_int(array_length(sorted), 1, 5, `a sensible element count`);
test_assert_equal_array(sorted, expected, `the sorted order`);
test_assert_array_length(sorted, 3, `every element survived the sort`);
test_assert_array_contains(sorted, 2, `the middle value is still there`);
test_assert_array_not_empty(sorted, `the sorted array holds the elements`);

nothing:a:i = [];
test_assert_array_empty(nothing, `a fresh array holds no elements`);

greeting:s = string_concat([`hello `, `world`]);
test_assert_equal_string(greeting, `hello world`, `the greeting`);
test_assert_not_equal_string(greeting, `goodbye`, `the greeting is not a farewell`);
test_assert_contains(greeting, `lo wo`, `the greeting spans both halves`);
test_assert_not_contains(greeting, `bye`, `no farewell hides in the greeting`);
test_assert_starts_with(greeting, `hello`, `the greeting opens with hello`);
test_assert_ends_with(greeting, `world`, `the greeting closes with world`);

finished:b = true;
test_assert_equal_bool(finished, true, `the job finished`);

// Floats are compared with a tolerance, because 0.1 plus 0.2 is not exactly
// 0.3 on any machine with hardware floats. Ordering needs no tolerance.
total:f = 0.1 + 0.2;
test_assert_equal_float(total, 0.3, 0.000001, `the running total`);
test_assert_greater_float(total, 0.2, `the total grew past the first part`);
test_assert_less_float(total, 0.4, `the total stayed in bounds`);

ages:h<s,i> = hashmap_new();
hashmap_set(ages, `ada`, 36);
hashmap_set(ages, `grace`, 45);
ages_again:h<s,i> = hashmap_new();
hashmap_set(ages_again, `grace`, 45);
hashmap_set(ages_again, `ada`, 36);
test_assert_equal_hashmap(ages, ages_again, `insertion order does not matter`);

print(`every assertion held`);
