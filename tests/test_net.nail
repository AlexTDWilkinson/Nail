// The network below HTTP: what a name resolves to, and whether a port is open.
// Every call takes a deadline, because a network operation without one is how a
// program hangs forever with nothing in the log.

addresses:a:s = danger(net_dns_lookup(`localhost`));
test_assert(array_length(addresses) > 0, `localhost resolves to something`);

// Port 9 is discard, which nothing on a developer machine listens on, so this
// is the "nothing there" answer rather than an error.
open:b = danger(net_tcp_is_open(`127.0.0.1`, 9, 500));
test_assert_false(open, `a port with nothing listening is not open`);

// A name that cannot resolve, a port that is not a port, and a deadline of zero
// are all errors rather than hangs.
f unreachable(err:e):b { r false; }
missing:b = safe(net_tcp_is_open(`this-name-does-not-exist.invalid`, 80, 500), unreachable);
test_assert_false(missing, `a name that does not resolve`);

f no_answer(err:e):s { r `refused`; }
bad_port:s = safe(net_tcp_request(`127.0.0.1`, 0, `x`, 500), no_answer);
test_assert_equal_string(bad_port, `refused`, `zero is not a port`);

no_deadline:s = safe(net_tcp_request(`127.0.0.1`, 80, `x`, 0), no_answer);
test_assert_equal_string(no_deadline, `refused`, `and nothing waits forever`);

silent:s = safe(net_udp_request(`127.0.0.1`, 9, `STATUS`, 200), no_answer);
test_assert_equal_string(silent, `refused`, `a datagram nobody answers times out`);

print(`every network call held`);
