// Fixture for the import checker unit tests. Valid on its own, but a
// program that brings it in with import must be rejected twice: sandboxed
// code may not block the program with time_sleep and may not seize stdout
// with print. The log_line function is the allowed case, stderr logging.
f sandboxed_wait():v {
    time_sleep(0.1);
}

f sandboxed_shout():v {
    print(`sandboxed code should not own stdout`);
}

f log_line():v {
    log_info(`stderr logging is allowed in sandboxed code`);
}
