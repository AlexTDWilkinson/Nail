// Fibonacci example from the website

// Calculate fibonacci sequence
f fib(num:i):i {
    result:i = if {
        num <= 1 -> { r num; },
        else -> { r fib(num - 1) + fib(num - 2); }
    };
    r result;
}

// Generate first 10 fibonacci numbers  
nums:a:i = array_range(0, 10);
sequence:a:i = map index in nums {
    y fib(index);
};

print(`Fibonacci sequence: `, sequence);