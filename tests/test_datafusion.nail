// Test DataFusion analytics functions

struct Person {
    name:s,
    age:i
}

// Open an in-memory DataFusion session
db:DB_DataFusion = danger(db_datafusion_session());
print(`Opened DataFusion session`);

// Create a table and insert rows
create_result:DB_DataFusion_Result = danger(db_datafusion_execute(db, `CREATE TABLE people (name VARCHAR, age INT)`));
insert_result:DB_DataFusion_Result = danger(db_datafusion_execute(db, `INSERT INTO people VALUES ('Alice', 30), ('Bob', 25), ('Charlie', 35)`));
print(`Inserted rows: `, insert_result.rows_affected);

// Query all rows as typed structs
people:a:Person = danger(db_datafusion_query(db, `SELECT name, age FROM people ORDER BY age`));
first_person:Person = danger(array_first(people));
print(`Youngest person: `, first_person.name);

// Query a single row
oldest:Person = danger(db_datafusion_query_single(db, `SELECT name, age FROM people ORDER BY age DESC LIMIT 1`));
print(`Oldest person: `, oldest.name, ` age: `, oldest.age);

// Close the session
danger(db_datafusion_close(db));
print(`DataFusion test complete`);
