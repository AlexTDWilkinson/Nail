// Storing a password, and checking one. The only correct way to do this.

// Never crypto_hash_sha256 for a password: a graphics card computes those
// billions of times a second, so a stolen table of them is a stolen table of
// passwords. Argon2id is deliberately slow and memory-hungry.
stored:s = danger(crypto_hash_password(`correct horse battery staple`));

// The hash carries its own random salt, so the same password hashed twice
// gives two different strings. That is why you never compare these with ==.
stored_again:s = danger(crypto_hash_password(`correct horse battery staple`));
test_assert_false(stored == stored_again, `each hash carries its own salt`);

// Both still verify, because the salt travels inside the stored string.
test_assert(danger(crypto_verify_password(`correct horse battery staple`, stored)), `the right password is accepted`);
test_assert(danger(crypto_verify_password(`correct horse battery staple`, stored_again)), `the same password against the other hash`);

// A wrong password is false.
test_assert_false(danger(crypto_verify_password(`Correct horse battery staple`, stored)), `one wrong letter is rejected`);

// A stored value that is not a hash at all is not a wrong password: it is a row
// that can never match any password, so it says so rather than looking like a
// failed login forever. A caller that would rather fail closed asks for that.
f locked_out(err:e):b { r false; }
test_assert_false(safe(crypto_verify_password(`anything`, `not a hash at all`), locked_out), `a corrupted row lets nobody in`);

// Digests, which are for checksums and signatures rather than passwords.
sha256:s = crypto_hash_sha256(`hello`);
sha512:s = crypto_hash_sha512(`hello`);
test_assert_equal_int(string_length(sha256), 64, `a SHA-256 digest is 64 hex characters`);
test_assert_equal_int(string_length(sha512), 128, `a SHA-512 digest is 128 hex characters`);

// Version 7 ids sort by the time they were made, which is what a database
// wants from a primary key. Version 4 ids deliberately do not.
sortable_id:s = crypto_uuid_v7();
random_id:s = crypto_uuid_v4();
test_assert_equal_int(string_length(sortable_id), 36, `a UUID is 36 characters`);
test_assert_equal_int(string_length(random_id), 36, `a UUID is 36 characters`);

print(`every password check held`);
